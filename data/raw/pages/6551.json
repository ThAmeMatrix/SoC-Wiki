ages/llzj/thumb/c/c0/i1qqp28rebkyu4nevr0jo615xhwvhu7.png/65px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E5%85%A8%E7%9B%9B%E5%A7%BF%E6%80%81.png\" decoding=\"async\" loading=\"lazy\" width=\"65\" height=\"65\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/c/c0/i1qqp28rebkyu4nevr0jo615xhwvhu7.png/98px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E5%85%A8%E7%9B%9B%E5%A7%BF%E6%80%81.png 1.5x, https://patchwiki.biligame.com/images/llzj/c/c0/i1qqp28rebkyu4nevr0jo615xhwvhu7.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></div>\n    <div class=\"gx_name\"><a href=\"/llzj/%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE/%E5%85%A8%E7%9B%9B%E5%A7%BF%E6%80%81\" title=\"极限解放/全盛姿态\"><font color=\"#FFF\">全盛姿态</font></a></div>\n    </div>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:15%;\">关联内容\n</th>\n<td style=\"text-align:left\">\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">角色绰号\n</th>\n<td>会长，富婆，坏女人\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配置推荐\n</th>\n<td>同下\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色攻略\n</th>\n<td>【by超能缪缪】<a rel=\"nofollow\" class=\"external free\" href=\"http://game.bilibili.com/linkfilter/?url=https%3A%2F%2Fwww.taptap.cn%2Fmoment%2F733293249506051793\" target=\"_blank\">https://www.taptap.cn/moment/733293249506051793</a>\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">中文CV\n</th>\n<td>曾彤\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">日文CV\n</th>\n<td>斋藤千和\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配音展示\n</th>\n<td>【byThAmeReborn】<a rel=\"nofollow\" class=\"external free\" href=\"https://www.bilibili.com/video/BV1Sp1TBSEsV\">https://www.bilibili.com/video/BV1Sp1TBSEsV</a>\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色生平\n</th>\n<td>沙娜姿，埃拉曼第一商会——哈沙拉姆商会的会长。她智谋超群，处事圆滑，总能游刃有余地穿行于错综复杂的势力之间，人称“埃拉曼没有她办不成的事”。<br />但无人知晓，她生来便深陷“遗忘症”的诅咒，记忆仿若流沙，被时间的浪潮不断冲刷消逝。这种身陷黑洞般的痛苦折磨了沙娜姿很长时间。直到她接受了烙痕改造，“遗忘症”才得以遏制。这次重生，让她得以洞悉烙痕背后蕴藏的无限可能。<br />然而在埃拉曼，烙痕的强大力量仅被用于取悦奴隶主，无法惠及普通人，其解放生产的潜能完全被埋没。为了打破这层禁锢，将命运牢牢攥在自己手中，沙娜姿投身于烙痕研究之中，静待席卷哈沙拉姆的风暴来临。\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width: 100%;\">\n<tbody><tr>\n<th>原皮肤像素模型</th>\n<th>皮肤像素模型\n</th></tr>\n<tr>\n<td style=\"text-align: center; width: 50%;\"><a href=\"/llzj/%E6%96%87%E4%BB%B6:%E6%B2%99%E5%A8%9C%E5%A7%BF_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" class=\"image\"><img alt=\"沙娜姿 像素模型.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/82/loiu0hmbbwwpagx857g313r5o2dz3zc.png/100px-%E6%B2%99%E5%A8%9C%E5%A7%BF_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"100\" srcset=\"https://patchwiki.biligame.com/images/llzj/8/82/loiu0hmbbwwpagx857g313r5o2dz3zc.png 1.5x\" data-file-width=\"128\" data-file-height=\"128\" /></a></td>\n<td style=\"text-align: center; width: 50%;\"><a href=\"/llzj/%E6%96%87%E4%BB%B6:%E6%B2%99%E5%A8%9C%E5%A7%BF_%E7%9A%AE%E8%82%A4%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" class=\"image\"><img alt=\"沙娜姿 皮肤像素模型.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/1/19/2m0ytu4goowpglmcrev61bv9ekdl3rd.png/100px-%E6%B2%99%E5%A8%9C%E5%A7%BF_%E7%9A%AE%E8%82%A4%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"100\" srcset=\"https://patchwiki.biligame.com/images/llzj/1/19/2m0ytu4goowpglmcrev61bv9ekdl3rd.png 1.5x\" data-file-width=\"128\" data-file-height=\"128\" /></a>\n</td></tr>\n<tr>\n<th colspan=\"2\">皮肤演示视频\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\">\n<p>【by 白骑一护】<a rel=\"nofollow\" class=\"external free\" href=\"https://www.bilibili.com/video/BV1AryZB2EvN\">https://www.bilibili.com/video/BV1AryZB2EvN</a>\n</p>\n<