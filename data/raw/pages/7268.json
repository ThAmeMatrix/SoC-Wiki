BA%BA%E7%89%A9_%E5%8F%B6%E5%A5%88%E6%B3%95.png\" class=\"image\"><img alt=\"像素人物 叶奈法.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/f5/kg4rhty6u1adr7q2g7qp9xy4mgyvtnu.png/75px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E5%8F%B6%E5%A5%88%E6%B3%95.png\" decoding=\"async\" loading=\"lazy\" width=\"75\" height=\"94\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/f/f5/kg4rhty6u1adr7q2g7qp9xy4mgyvtnu.png/113px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E5%8F%B6%E5%A5%88%E6%B3%95.png 1.5x, https://patchwiki.biligame.com/images/llzj/f/f5/kg4rhty6u1adr7q2g7qp9xy4mgyvtnu.png 2x\" data-file-width=\"128\" data-file-height=\"160\" /></a>\n</th></tr>\n</tbody></table>\n<p>以上角色在女神的试炼的出场率极高，可极大地降低通关难度。\n</p><p><br /><font size=\"4\"><b>视频攻略（by Azhar）</b></font><br />\n女神的试炼1-20关视频攻略合集：<a rel=\"nofollow\" class=\"external free\" href=\"https://space.bilibili.com/154291178/lists/7786625?type=season\">https://space.bilibili.com/154291178/lists/7786625?type=season</a><br />\n关于女神的试炼20：<br />\n难度最高的关卡，难点在于：1.60%免伤光环 2.boss每回合稳定aoe定身、高额回复、每回合增加双盾、大量debuff等。主流打法分为直伤流和穿透流。<br />\n1.直伤流：boss光环会给全体敌方提供60%免伤，因此需要具有[<font color=\"#f3c156\">孤立</font>]的角色解除光环效果，方能有效造成伤害。关键角色为<a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%8D%A1%E5%A7%86%E6%B4%9B%E7%89%B9\" title=\"角色图鉴库/卡姆洛特\"><img alt=\"像素人物 卡姆洛特.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/6/6f/pz03qeoaw8jfy0awsu8jbupnxt4k30z.png/40px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E5%8D%A1%E5%A7%86%E6%B4%9B%E7%89%B9.png\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"50\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/6/6f/pz03qeoaw8jfy0awsu8jbupnxt4k30z.png/60px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E5%8D%A1%E5%A7%86%E6%B4%9B%E7%89%B9.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/6/6f/pz03qeoaw8jfy0awsu8jbupnxt4k30z.png/80px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E5%8D%A1%E5%A7%86%E6%B4%9B%E7%89%B9.png 2x\" data-file-width=\"128\" data-file-height=\"160\" /></a>和<a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%A7%91%E7%93%A6%E9%9B%B7\" title=\"角色图鉴库/科瓦雷\"><img alt=\"像素人物 柯瓦雷.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/2d/hr83g997v7fhwr0iowpuakbsbek1993.png/40px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E6%9F%AF%E7%93%A6%E9%9B%B7.png\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"51\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/2/2d/hr83g997v7fhwr0iowpuakbsbek1993.png/60px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E6%9F%AF%E7%93%A6%E9%9B%B7.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/2/2d/hr83g997v7fhwr0iowpuakbsbek1993.png/80px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E6%9F%AF%E7%93%A6%E9%9B%B7.png 2x\" data-file-width=\"126\" data-file-height=\"160\" /></a>，但此打法对练度的要求极高！<br />\n2.穿透流：核心在于塞娜<a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%A1%9E%E5%A8%9C\" title=\"角色图鉴库/塞娜\"><img alt=\"像素人物 塞娜.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/6/6c/r7sqvm74u1x1jblw6ebib2r2xx8eydt.png/40px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E5%A1%9E%E5%A8%9C.png\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"50\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/6/6c/r7sqvm74u1x1jblw6ebib2r2xx8eydt.png/60px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E5%A1%9E%E5%A8%9C.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/6/6c/r7sqvm74u1x1jblw6ebib2r2xx8eydt.png/80px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E5%A1%9E%E5%A8%9C.png 2x\" data-file-width=\"128\" data-file-height=\"160\" /></a>、芬恩<a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E8%8A%AC%E6%81%A9\" title=\"角色图鉴库/芬恩\"><img alt=\"像素人物 芬恩.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/7/73/5x4d8x6vsfe41yz80z43yv4mffoa4gu.png/40px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E8%8A%AC%E6%81%A9.png\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"50\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/7/73/5x4d8x6vsfe41yz80z43yv4mffoa4gu.png/60px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E8%8A%AC%E6%81%A9.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/7/73/5x4d8x6vsfe41yz80z43yv4mffoa4gu.png/80px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E8%8A%AC%E6%81%A9.png 2x\" data-file-width=\"128\" data-file-height=\"160\" /></a>、伊瑟琳德<a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E4%BC%8A%E7%91%9F%E7%90%B3%E5%BE%B7\" title=\"角色图鉴库/伊瑟琳德\"><img alt=\"像素人物 伊瑟琳德.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/4/49/6rhy3j8gh4kc4c07njjpk7rs6bm5yma.png/40px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E4%BC%8A%E7%91%9F%E7%90%B3%E5%BE%B7.png\" decoding=\"async\" loading=\"lazy\" width=\"40\" height=\"50\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/4/49/6rhy3j8gh4kc4c07njjpk7rs6bm5yma.png/60px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E4%BC%8A%E7%91%9F%E7%90%B3%E5%BE%B7.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/4/49/6rhy3j8gh4kc4c07njjpk7rs6bm5yma.png/80px-%E5%83%8F%E7%B4%A0%E4%BA%BA%E7%89%A9_%E4%BC%8A%E7%91%9F%E7%90%B3%E5%BE%B7.png 2x\" data-file-width=\"128\" data-file-height=\"160\" /></a>无视免伤和双盾的穿透伤害从而直接造成有效伤害，对练度要求相对不高，建议选择此类打法。\n<br /><a href=\"/llzj/%E6%96%87%E4%BB%B6:%E5%AE%98%E6%96%B9%E6%B6%88%E6%81%AF162.png\" class=\"image\"><img alt=\"官方消息162.png\" src=\"https://patchwiki.biligame.com/images/llzj/d/d6/svw1kgm80z16l73m4cyr5qbzzppqu7h.png\" decoding=\"async\" loading=\"lazy\" width=\"1500\" height=\"200\" data-file-width=\"750\" data-file-height=\"100\" /></a><br />\n</p>\n</div>\n</div>\n</div></div>\n</div></div></div></div>\n<!-- \nNewPP limit report\nCached time: 20261022084248\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.088 seconds\nReal time usage: 0.157 seconds\nPreprocessor visited node count: 297/1000000\nPost‐expand include size: 3204/2097152 bytes\nTemplate argument size: 583/2097152 bytes\nHighest expansion depth: 5/40\nExpensive parser function count: 0/100\nUns