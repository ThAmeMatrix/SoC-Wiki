zj/thumb/d/d5/l5em65p0sgmdteeyypswpwhvbiyl2ad.png/80px-%E6%8A%80%E8%83%BD_%E5%87%9B%E5%86%AC%E7%BB%88%E8%A2%AD.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/d/d5/l5em65p0sgmdteeyypswpwhvbiyl2ad.png/120px-%E6%8A%80%E8%83%BD_%E5%87%9B%E5%86%AC%E7%BB%88%E8%A2%AD.png 1.5x, https://patchwiki.biligame.com/images/llzj/d/d5/l5em65p0sgmdteeyypswpwhvbiyl2ad.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />凛冬终袭\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>1\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）退出[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"蛮熊形态\" class=\"bili-tt\"><font color=\"#54b4db\">蛮熊形态</font></span></span>]，对自身范围<font color=\"#ed7950\">3</font>格内所有敌人造成<font color=\"#ed7950\">70%</font>[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰属性\" class=\"bili-tt\"><font color=\"orange\">冰属性</font></span></span>][<span style=\"display:inline;white-space:nowrap;\">范围伤害</span>]，施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼速度1\" class=\"bili-tt\"><font color=\"orange\">▼速度1</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼移动1\" class=\"bili-tt\"><font color=\"orange\">▼移动1</font></span></span>]。攻击后，可再移动<font color=\"#ed7950\">3</font>格。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-0 2.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/b/bb/qlqfhw2nk8ggpo6od4xm6wbe6428tai.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-0_2.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/b/bb/qlqfhw2nk8ggpo6od4xm6wbe6428tai.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E9%98%BF%E5%88%97%E5%85%8B%E8%B0%A2%E2%80%A2%E9%A3%8E%E9%9B%AA%E5%AD%A4%E8%A1%8C\" title=\"角色图鉴库/阿列克谢•风雪孤行\"><img alt=\"头像 阿列克谢•风雪孤行.png\" src=\"https://patchwiki.biligame.com/images/llzj/e/e7/p3uev98o9wqyvt0sj9v59pw1twf9swg.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">阿列克谢•风雪孤行</font></div>\n</div></div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:ce