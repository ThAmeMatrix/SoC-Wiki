ikitable\" style=\"width:100%;max-width: 800px; margin:auto; text-align:center; table-layout:fixed; word-break:break-all; background:#fffaf5; border:1px solid #ffccbc; border-radius:8px; white-space:normal;\">\n<caption><div style=\"margin-top: 10px; margin-bottom: 10px; text-align: center; visibility: visible;\">\n<div style=\"display: inline-block; vertical-align: middle; width: 10px; visibility: visible;\">\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div></div>\n<div style=\"display: inline-block; vertical-align: middle; padding-left: 6px; padding-right: 6px; font-size: 17px; visibility: visible;\"><p style=\"visibility: visible;\"><strong style=\"visibility: visible;\">铃兰之剑资源统计2026/07</strong></p></div>\n<div style=\"display: inline-block; vertical-align: middle; width: 10px; visibility: visible;\">\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div></div></div>\n</caption>\n<tbody><tr>\n<th style=\"width:14%\">项目\n</th>\n<th style=\"width:12%\">希望晶石\n</th>\n<th style=\"width:9%\">秘缘\n</th>\n<th style=\"width:8%\">领悟之力\n</th>\n<th style=\"width:11%\">星铸残胚\n</th>\n<th style=\"width:16%\">晶石算法\n</th>\n<th style=\"width:30%\">备注\n</th></tr>\n<tr>\n<td>签到</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*100</td>\n<td>\n</td></tr>\n<tr>\n<td>日常任务</td>\n<td>1860</td>\n<td></td>\n<td></td>\n<td></td>\n<td>31*60</td>\n<td>\n</td></tr>\n<tr>\n<td>频道活跃</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*100</td>\n<td>4次周一\n</td></tr>\n<tr>\n<td>大月卡(免费)</td>\n<td>250</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>荣耀之战</td>\n<td>605</td>\n<td></td>\n<td>1</td>\n<td></td>\n<td>5*31+150+300</td>\n<td>日常奖励、活跃奖励、排名奖励\n</td></tr>\n<tr>\n<td>征服之塔</td>\n<td>1520</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*380</td>\n<td>4次周一\n</td></tr>\n<tr>\n<td>维护更新</td>\n<td>600</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>7月2日闪断50钻<br />7月9日更新150钻<br />7月16日闪断50钻<br />7月23日更新300钻<br />7月30日闪断50钻\n</td></tr>\n<tr>\n<td>角色试用</td>\n<td>300</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*150</td>\n<td>科尔·破晓之影150钻<br />克莱雅150钻\n</td></tr>\n<tr>\n<td>解码心象风景</td>\n<td>750</td>\n<td></td>\n<td></td>\n<td></td>\n<td>50*8+150+50*4</td>\n<td>\n</td></tr>\n<tr>\n<td>共揽星碑</td>\n<td>900</td>\n<td></td>\n<td></td>\n<td>200</td>\n<td>100+200*4</td>\n<td>\n</td></tr>\n<tr>\n<td>全域推演</td>\n<td>2350</td>\n<td></td>\n<td>1</td>\n<td>450</td>\n<td>200*6+1150</td>\n<td>活动任务1150钻<br />关卡奖励1200钻\n</td></tr>\n<tr>\n<td>愚者18章高难</td>\n<td>650</td>\n<td>1</td>\n<td>1</td>\n<td></td>\n<td>50*7+200+100</td>\n<td>绝境残光7关50钻+星级奖励200钻<br />活动任务100钻\n</td></tr>\n<tr>\n<td>追光寻忆</td>\n<td>20</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>活动首页赠送\n</td></tr>\n<tr>\n<td>祷铃寄愿</td>\n<td></td>\n<td>10</td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>浪涌杯争霸赛</td>\n<td>1060</td>\n<td>5</td>\n<td>1</td>\n<td></td>\n<td>60+10*40+15*40</td>\n<td>积分5秘缘+任务60钻<br />赛前训练10*40钻<br />正赛争锋15*40钻\n</td></tr>\n<tr>\n<td>克莱雅皮肤</td>\n<td>200</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*50</td>\n<td>前15级免费档位\n</td></tr>\n<tr>\n<td>调查问卷</td>\n<td>150</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>7月24日\n</td></tr>\n<tr>\n<td>铸铃为谁而鸣</td>\n<td>1400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>23*40+12*40</td>\n<td>剧情23*40钻<br />孤城血战12关40钻\n</td></tr>\n<tr>\n<td>启示录塔罗牌17章</td>\n<td>160</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*80</td>\n<td>\n</td><