ng/65px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E4%B8%8D%E7%A0%B4%E9%92%A2%E9%93%81%E4%B9%8B%E5%BF%97.png\" decoding=\"async\" loading=\"lazy\" width=\"65\" height=\"65\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/8/8b/5a7kvz9mk6t9okpll1rfmhsw1knwujf.png/98px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E4%B8%8D%E7%A0%B4%E9%92%A2%E9%93%81%E4%B9%8B%E5%BF%97.png 1.5x, https://patchwiki.biligame.com/images/llzj/8/8b/5a7kvz9mk6t9okpll1rfmhsw1knwujf.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></div>\n    <div class=\"gx_name\"><a href=\"/llzj/%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE/%E4%B8%8D%E7%A0%B4%E9%92%A2%E9%93%81%E4%B9%8B%E5%BF%97\" title=\"极限解放/不破钢铁之志\"><font color=\"#FFF\">不破钢铁之志</font></a></div>\n    </div>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:15%;\">关联内容\n</th>\n<td style=\"text-align:left\">\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">角色绰号\n</th>\n<td>裁决王（菜撅王）\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配置推荐\n</th>\n<td>同下\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色攻略\n</th>\n<td>【by超能缪缪】<a rel=\"nofollow\" class=\"external free\" href=\"http://game.bilibili.com/linkfilter/?url=https%3A%2F%2Fwww.taptap.cn%2Fmoment%2F682557798776572483\" target=\"_blank\">https://www.taptap.cn/moment/682557798776572483</a>\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">中文CV\n</th>\n<td>董胜章\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">日文CV\n</th>\n<td>稻田彻\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配音展示\n</th>\n<td>【byThAmeReborn】<a rel=\"nofollow\" class=\"external free\" href=\"https://www.bilibili.com/video/BV1LiMTznEH1\">https://www.bilibili.com/video/BV1LiMTznEH1</a>\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色生平\n</th>\n<td>三大骑士王之一的卡姆洛特，在第二次光辉之战后重整了摇摇欲坠的骑士诸国同盟，使之以强大而一致的力量迅速崛起为影响罗迪尼亚大陆的绝对强权。<br />在一次次战争中，卡姆洛特亲自冲锋陷阵，碾压般消灭挡路之敌。他热烈、豪迈、富有感染力，为骑士同盟赢得荣耀和利益，受到麾下骑士们自发的忠诚和拥戴。<br />卡姆洛特的理想是征服一切所见之地，实现罗迪尼亚大陆的大一统霸业，但他不屑于为此操弄阴谋——弱肉强食是世界唯一的规则，那就用绝对的力量来完成这只属于自己的征服。\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width: 100%;\">\n<tbody><tr>\n<th>原皮肤像素模型</th>\n<th>皮肤像素模型\n</th></tr>\n<tr>\n<td style=\"text-align: center; width: 50%;\"><a href=\"/llzj/%E6%96%87%E4%BB%B6:%E5%8D%A1%E5%A7%86%E6%B4%9B%E7%89%B9_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" class=\"image\"><img alt=\"卡姆洛特 像素模型.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/1/1c/41t0qcy1wql9dngwc47cbranhicg1hn.png/100px-%E5%8D%A1%E5%A7%86%E6%B4%9B%E7%89%B9_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"100\" srcset=\"https://patchwiki.biligame.com/images/llzj/1/1c/41t0qcy1wql9dngwc47cbranhicg1hn.png 1.5x\" data-file-width=\"128\" data-file-height=\"128\" /></a></td>\n<td style=\"text-align: center; width: 50%;\"><a href=\"/llzj/%E6%96%87%E4%BB%B6:%E5%8D%A1%E5%A7%86%E6%B4%9B%E7%89%B9_%E7%9A%AE%E8%82%A4%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B1.png\" class=\"image\"><img alt=\"卡姆洛特 皮肤像素模型1.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/1/15/nqvvpqy2eagysmqjholvahbgrai50d5.png/100px-%E5%8D%A1%E5%A7%86%E6%B4%9B%E7%89%B9_%E7%9A%AE%E8%82%A4%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B1.png\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"100\" srcset=\"https://patchwiki.biligame.com/images/llzj/1/15/nqvvpqy2eagysmqjholvahbgrai50d5.png 1.5x\" data-file-width=\"128\" data-file-height=\"128\" /></a>\n</td></tr>\n<tr>\n<th colspan=\"2\">皮肤演示视频\n</th></tr>\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\">\n<p>【by 白骑一护】<a rel=\"nofollow\" class=\"external free\" href=\"https://www.bilibili.com/video/BV1TaMbzYE94\">https://www.bilibili.com/video/BV1TaMbzYE94</a>\n</p>\n</td></tr>\