zj/thumb/d/df/ftqbxs9nzmwg7gy4plt0daobtf2x8dl.png/80px-%E6%8A%80%E8%83%BD_%E5%9D%9A%E9%94%85%E9%93%81%E5%A3%81.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/d/df/ftqbxs9nzmwg7gy4plt0daobtf2x8dl.png/120px-%E6%8A%80%E8%83%BD_%E5%9D%9A%E9%94%85%E9%93%81%E5%A3%81.png 1.5x, https://patchwiki.biligame.com/images/llzj/d/df/ftqbxs9nzmwg7gy4plt0daobtf2x8dl.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />坚锅铁壁\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>1\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（支援）获得<font color=\"#ed7950\">3</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"森西的满足\" class=\"bili-tt\"><font color=\"#54b4db\">森西的满足</font></span></span>]，并朝正面举起大锅，[<span style=\"display:inline;white-space:nowrap;\">正面</span>]受到伤害降低<font color=\"#ed7950\">40%</font>，[<span style=\"display:inline;white-space:nowrap;\">侧面</span>]受到伤害降低<font color=\"#ed7950\">20%</font>，效果持续到下次行动开始。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-0 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/84/lekhjouylcdedt30jvnh0upev2fjg1