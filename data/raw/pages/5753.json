%89%E8%BE%89%E7%9A%84%E8%AF%95%E7%82%BC.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/3/3f/4s7tx5ybnrd4f1ofix0kz88f2hk3hqp.png/120px-%E6%8A%80%E8%83%BD_%E5%85%89%E8%BE%89%E7%9A%84%E8%AF%95%E7%82%BC.png 1.5x, https://patchwiki.biligame.com/images/llzj/3/3f/4s7tx5ybnrd4f1ofix0kz88f2hk3hqp.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />光辉的试炼\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:10%;\"><center><b>&#160;技能类别<br /></b>[职业技能]</center>\n</td>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\">&#160;\n<p>（被动）拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"强韧\" class=\"bili-tt\"><font color=\"orange\">强韧</font></span></span>]。行动开始时，若自身处于[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"受伤\" class=\"bili-tt\"><font color=\"orange\">受伤</font></span></span>]状态，则获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"圣启\" class=\"bili-tt\"><font color=\"#54b4db\">圣启</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合。行动结束时，若自身没有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"祷求圣启\" class=\"bili-tt\"><font color=\"#54b4db\">祷求圣启</font></span></span>]或[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"圣启\" class=\"bili-tt\"><font color=\"#54b4db\">圣启</font></span></span>]，则牺牲<font color=\"#ed7950\">20%</font>当前生命值，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"祷求圣启\" class=\"bili-tt\"><font color=\"#54b4db\">祷求圣启</font></span></span>]，效果持续到下次行动开始。\n</p>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div>\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E6%9F%AF%E8%8E%B1%E4%B8%B9%E8%90%A8\" title=\"角色图鉴库/柯莱丹萨\"><img alt=\"头像 柯莱丹萨.png\" src=\"https://patchwiki.biligame.com/images/llzj/b/b1/8alpxilholfae5nspjamwlp8tip5jm1.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">柯莱丹萨</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div>\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n\n<!-- \nNewPP limit report\nCached time: 20261022044508\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.432 seconds\nReal time usage: 0.610 seconds\nPreprocessor visited node count: 9777/1000000\nPost‐expand include size: 158570/2097152 bytes\nTemplate argument size: 13326/2097152 bytes\nHighest expansion depth: 13/40\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\nExtLoops count: 0\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  587.753      1 模板:简单技能\n100.00%  587.753      1 -total\n 11.70%   68.740      1 模板:中括号介绍化\n 10.94%   64.289      6 模板:中括号介绍\n  2.66%   15.613      1 模板:面包屑\n  0.87%    5.113      1 模板:列表/头像\n-->\n\n<!-- Saved 