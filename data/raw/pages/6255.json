zj/thumb/a/a9/subcm0f26fqh940g29fvfjtu246cn5k.png/80px-%E6%8A%80%E8%83%BD_%E8%81%9A%E6%B2%99%E5%8D%B7%E8%A2%AD.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/a/a9/subcm0f26fqh940g29fvfjtu246cn5k.png/120px-%E6%8A%80%E8%83%BD_%E8%81%9A%E6%B2%99%E5%8D%B7%E8%A2%AD.png 1.5x, https://patchwiki.biligame.com/images/llzj/a/a9/subcm0f26fqh940g29fvfjtu246cn5k.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />聚沙卷袭\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>4\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>近战、对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-1\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"解放枷锁\" class=\"bili-tt\"><font color=\"#f3c156\">解放枷锁</font></span></span>]，单体攻击，造成<font color=\"#ed7950\">150%</font>[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"沙属性\" class=\"bili-tt\"><font color=\"#f3c156\">沙属性</font></span></span>]伤害，若目标处于[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"沙尘\" class=\"bili-tt\"><font color=\"#f3c156\">沙尘</font></span></span>]地形格，则伤害额外增加<font color=\"#ed7950\">30%</font>：攻击前驱散目标<font color=\"#ed7950\">3</font>个[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"减益\" class=\"bili-tt\"><font color=\"#f3c156\">减益</font></span></span>]。释放技能后，若拥有下述[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"解放\" class=\"bili-tt\"><font color=\"#f3c156\">解放</font></span></span>]层数，则消耗对应层数并触发效果：<br />✦拥有<font color=\"#ed7950\">5</font>层时，攻击前附加物攻值<font color=\"#ed7950\">30%</font>的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"沙属性\" class=\"bili-tt\"><font color=\"#f3c156\">沙属性</font></span></span>][<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"穿透伤害\" class=\"bili-tt\"><font color=\"orange\">穿透伤害</font></span></span>]\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-1 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/7/75/i12b13xi6nu3o31dwphrlipg2xm3bxm.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-1_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/7/75/i12b13xi6nu3o31dwphrlipg2xm3bxm.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%9F%83%E6%8B%89%E6%9B%BC%E5%95%86%E9%98%9F%E7%9B%BE%E5%8D%AB\" title=\"角色图鉴库/埃拉曼商队盾卫\"><img alt=\"头像 埃拉曼商队盾卫.png\" src=\"https://patchwiki.biligame.com/images/llzj/8/8f/bxsvyyf0p14vnljrs4mzfl8su4pw2w7.png\" decoding=\"async\" 