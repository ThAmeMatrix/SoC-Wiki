zj/thumb/0/03/mdvgdjm69h9bcjveefxbormm31jipvp.png/80px-%E6%8A%80%E8%83%BD_%E9%81%BF%E9%A3%8E%E6%B8%AF%E6%B9%BE.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/0/03/mdvgdjm69h9bcjveefxbormm31jipvp.png/120px-%E6%8A%80%E8%83%BD_%E9%81%BF%E9%A3%8E%E6%B8%AF%E6%B9%BE.png 1.5x, https://patchwiki.biligame.com/images/llzj/0/03/mdvgdjm69h9bcjveefxbormm31jipvp.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />避风港湾\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓8-↑8\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（支援）使自身获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"免伤4\" class=\"bili-tt\"><font color=\"orange\">免伤4</font></span></span>]，且自身范围<font color=\"#ed7950\">3</font>格内所有己方获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲物防2\" class=\"bili-tt\"><font color=\"orange\">▲物防2</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲魔防2\" class=\"bili-tt\"><font color=\"orange\">▲魔防2</font></span></span>]及[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"穿透免伤3\" class=\"bili-tt\"><font color=\"orange\">穿透免伤3</font></span></span>]。所有效果持续<font color=\"#ed7950\">2</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-0 3.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/a/ae/hp9k0iltoe2iq8n6u80ny5dwrlv7l6n.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-0_3.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/a/ae/hp9k0iltoe2iq8n6u80ny5dwrlv7l6n.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E8%8E%89%E6%8B%89\" title=\"角色图鉴库/莉拉\"><img alt=\"头像 莉拉.png\" src=\"https://patchwiki.biligame.com/images/llzj/3/38/5qkci6uf4s3kmwxf02d4myqkdy3oz28.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">莉拉</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">