8%E6%9B%A6.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/0/09/npxb5i3sy2dna4uwy8eifg3hns7a6wh.png/120px-%E6%8A%80%E8%83%BD_%E6%99%A8%E6%9B%A6.png 1.5x, https://patchwiki.biligame.com/images/llzj/0/09/npxb5i3sy2dna4uwy8eifg3hns7a6wh.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />晨曦\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>远程、对单位、直击\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓5-↑3\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（魔法伤害）单体攻击，造成<font color=\"#d68fe2\">130%</font>物攻值的魔法伤害。攻击前，对目标造成随机<font color=\"#ed7950\">2</font>个[<span style=\"display:inline;white-space:nowrap;\">增益</span>]变为[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"1级属性减益\" class=\"bili-tt\"><font color=\"orange\">1级属性减益</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-3 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/0/02/m4gv8o4dpxzc7r9lpuzb4xhyp1ivq98.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-3_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/0/02/m4gv8o4dpxzc7r9lpuzb4xhyp1ivq98.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E8%BF%AA%E5%A1%94%E5%88%A9%E5%A5%A5\" title=\"角色图鉴库/迪塔利奥\"><img alt=\"头像 迪塔利奥.png\" src=\"https://patchwiki.biligame.com/images/llzj/8/88/4rw78thfvqzjvr7lfv32rzgx2qsrxd2.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">迪塔利奥</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n\n<!-- \nNewPP limit report\nCached time: 20261022084141\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.424 seconds\nReal time usage: 0.571 seconds\nPreprocessor visited node count: 9430/1000000\nPost‐expand include size: 161