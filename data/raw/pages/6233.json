A%E6%80%A7_%E7%BB%AF%E7%A0%82.png 1.5x, https://patchwiki.biligame.com/images/llzj/0/06/s8ruhqwugoytu0up5l5zp6j5m5uicwc.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />绯砂\n</th>\n<td class=\"wiki-bot text-left\" style=\"width:60%;\">&#160;<img alt=\"个性一星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/56px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/84px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/112px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>魔攻、魔防提高<font color=\"#d68fe2\">2%</font>。场上任意已方释放魔法伤害技能后，自身获得<font color=\"#ed7950\">1</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"解放\" class=\"bili-tt\"><font color=\"#f3c156\">解放</font></span></span>]，每回合最多触发<font color=\"#ed7950\">3</font>次。攻击拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"减益\" class=\"bili-tt\"><font color=\"#f3c156\">减益</font></span></span>]的敌人后，施加<font color=\"#ed7950\">1</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"粉碎枷锁\" class=\"bili-tt\"><font color=\"#f3c156\">粉碎枷锁</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:20%;\" rowspan=\"5\"><b>该个性属于</b><br /><br /><div class=\"hero_head\" style=\"width:90px;height:90px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%BB%AF%E7%A0%82\" title=\"角色图鉴库/绯砂\"><img alt=\"头像 绯砂.png\" src=\"https://patchwiki.biligame.com/images/llzj/4/43/j2l4km64646ldt790jox4iqujtbh4b7.png\" decoding=\"async\" loading=