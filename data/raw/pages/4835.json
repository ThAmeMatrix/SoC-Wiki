zj/thumb/e/e8/r1yau0cd5beoyndwv9jr72bt5x76bsq.png/80px-%E6%8A%80%E8%83%BD_%E8%A1%80%E8%89%B2%E4%B9%8B%E6%80%92.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e8/r1yau0cd5beoyndwv9jr72bt5x76bsq.png/120px-%E6%8A%80%E8%83%BD_%E8%A1%80%E8%89%B2%E4%B9%8B%E6%80%92.png 1.5x, https://patchwiki.biligame.com/images/llzj/e/e8/r1yau0cd5beoyndwv9jr72bt5x76bsq.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />血色之怒\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>0-0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）牺牲自身<font color=\"#ed7950\">90%</font>当前生命值，对自身范围<font color=\"#ed7950\">2</font>格内所有敌人造成<font color=\"#ed7950\">50%</font>伤害，之后自身进入[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"暴走状态\" class=\"bili-tt\"><font color=\"blue\">暴走状态</font></span></span>]，并可[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"再行动\" class=\"bili-tt\"><font color=\"orange\">再行动</font></span></span>]，所有技能冷却时间归零，回复所有能量。本技能每场战斗最多使用<font color=\"#ed7950\">1</font>次。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-0 2.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/b/bb/qlqfhw2nk8ggpo6od4xm6wbe6428tai.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-0_2.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/b/bb/qlqfhw2nk8ggpo6od4xm6wbe6428tai.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%BF%A0%E6%96%AF%E5%9D%A6\" title=\"角色图鉴库/翠斯坦\"><img alt=\"头像 翠斯坦.png\" src=\"https://patchwiki.biligame.com/images/llzj/f/f8/qxmiscgs2hzov40skvj0pwby5pcs8hf.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">翠斯坦</font></div>\n</div></div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<!-- \nNewPP limit report\