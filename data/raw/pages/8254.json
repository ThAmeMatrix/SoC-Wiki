5ct8.png/80px-%E6%8A%80%E8%83%BD_%E5%86%B0%E9%A3%8E%E5%88%83.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/b/bd/9j8h5wyleatiplqspqiyex182sw5ct8.png/120px-%E6%8A%80%E8%83%BD_%E5%86%B0%E9%A3%8E%E5%88%83.png 1.5x, https://patchwiki.biligame.com/images/llzj/b/bd/9j8h5wyleatiplqspqiyex182sw5ct8.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />冰风刃\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3*2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）对目标方向<font color=\"#ed7950\">3*2</font>区域每列首名敌人，造成<font color=\"#ed7950\">100%</font>[<span style=\"display:inline;white-space:nowrap;\">范围伤害</span>]，击退<font color=\"#ed7950\">2</font>格。攻击后，回复<font color=\"#58cb48\">2</font>点能量。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-3 3*2.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/7/73/ekzm8gog2cww1fg04g0vv2eoqqrijzp.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-3_3%2A2.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"78\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/7/73/ekzm8gog2cww1fg04g0vv2eoqqrijzp.png/120px-%E6%8A%80