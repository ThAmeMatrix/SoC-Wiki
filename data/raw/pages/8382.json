zj/thumb/4/43/j42vl6pf6wnqhbobz9jtbjfttcl2c0d.png/80px-%E6%8A%80%E8%83%BD_%E4%BA%A4%E7%BB%99%E5%86%B0%E7%A2%B4.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/4/43/j42vl6pf6wnqhbobz9jtbjfttcl2c0d.png/120px-%E6%8A%80%E8%83%BD_%E4%BA%A4%E7%BB%99%E5%86%B0%E7%A2%B4.png 1.5x, https://patchwiki.biligame.com/images/llzj/4/43/j42vl6pf6wnqhbobz9jtbjfttcl2c0d.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />交给冰碴\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-5\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓5-↑3\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（支援）选择己方，可使其和[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰碴\" class=\"bili-tt\"><font color=\"#54b4db\">冰碴</font></span></span>]交换位置，并使双方：获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"免伤3\" class=\"bili-tt\"><font color=\"orange\">免伤3</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"偏斜\" class=\"bili-tt\"><font color=\"#f3c156\">偏斜</font></span></span>]，持续2回合，及进行治疗，治疗量为物攻值<font color=\"#58cb48\">100%</font>，再驱散<font color=\"#ed7950\">2</font>个[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"减益\" class=\"bili-tt\"><font color=\"#f3c156\">减益</font></span></span>]。<br />✦目标为自身时，释放后可再移动<font color=\"#ed7950\">3</font>格。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-5 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/9/99/at4dr45s2ma4cti9dv4gkekpa78egvl.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-5_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/9/99/at4dr45s2ma4cti9dv4gkekpa78egvl.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E8%8A%AC%E6%81%A9\" title=\"角色图鉴库/芬恩\"><img alt=\"头像 芬恩.png\" src=\"https://patchwiki.biligame.com/images/llzj/1/1f/b01pwe1sho6hlyp6uhu9i7hkr0kz3jo.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">芬恩</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;just