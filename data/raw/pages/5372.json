F%E9%9B%AA.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/b/b2/g053i6xf01eihm1nqtpjwsgl0w8decd.png/120px-%E6%8A%80%E8%83%BD_%E8%B8%8F%E9%9B%AA.png 1.5x, https://patchwiki.biligame.com/images/llzj/b/b2/g053i6xf01eihm1nqtpjwsgl0w8decd.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />踏雪\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>2-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓5-↑3\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（穿透伤害）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，变身成[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"小鹿\" class=\"bili-tt\"><font color=\"DeepSkyBlue\">小鹿</font></span></span>]并跳跃至目标地形格，再对自身范围<font color=\"red\">2</font>格内所有敌人，造成魔攻值<font color=\"red\">20%</font>的伤害。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 2-3 2.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/7/7a/davtpqsgzwf7664p05po76sg00djnhx.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_2-3_2.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" c