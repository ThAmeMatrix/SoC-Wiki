zj/thumb/0/02/6ktqwb6042p2bphiofsan13i9bpcw3u.png/80px-%E6%8A%80%E8%83%BD_%E5%85%89%E8%BE%89%E7%9C%9F%E4%B9%89.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/0/02/6ktqwb6042p2bphiofsan13i9bpcw3u.png/120px-%E6%8A%80%E8%83%BD_%E5%85%89%E8%BE%89%E7%9C%9F%E4%B9%89.png 1.5x, https://patchwiki.biligame.com/images/llzj/0/02/6ktqwb6042p2bphiofsan13i9bpcw3u.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />光辉真义\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（支援）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，自身获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"光辉真义\" class=\"bili-tt\"><font color=\"#54b4db\">光辉真义</font></span></span>]。<br />✦[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"附属被动\" class=\"bili-tt\"><font color=\"#f3c156\">附属被动</font></span></span>]，效果：主动治疗前，驱散目标随机<font color=\"#ed7950\">2</font>个[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"减益\" class=\"bili-tt\"><font color=\"#f3c156\">减益</font></span></span>]；主动攻击前，对目标施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"穿透易伤2\" class=\"bili-tt\"><font color=\"orange\">穿透易伤2</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-0 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/84/lekhjouylcdedt30jvnh0upev2fjg1n.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-0_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/8/84/lekhjouylcdedt30jvnh0upev2fjg1n.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%8D%A1%E4%B8%BD%E4%B8%9D%E2%80%A2%E5%BA%87%E6%8A%A4%E4%B9%8B%E8%AA%93\" title=\"角色图鉴库/卡丽丝•庇护之誓\"><img alt=\"头像 卡丽丝•庇护之誓.png\" src=\"https://patchwiki.biligame.com/images/llzj/3/34/ax9hkbxkda6nbp2vlg6wqo4n55fe2ct.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">卡丽丝•庇护之誓</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br 