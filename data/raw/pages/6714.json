B8%AA%E6%80%A7%E5%9B%9B%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/1/10/eer5d47lht2ycljkd8fe3yu05q10ccr.png/112px-%E4%B8%AA%E6%80%A7%E5%9B%9B%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>魔攻值不受[<span style=\"display:inline;white-space:nowrap;\"><font color=\"#f3c156\">增益</font></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"减益\" class=\"bili-tt\"><font color=\"#f3c156\">减益</font></span></span>]影响，始终与物攻值相等。拥有技能[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"猎魔人的魔药\" class=\"bili-tt\"><font color=\"#54b4db\">猎魔人的魔药</font></span></span>]。<br />暴击率提高<font color=\"#ed7950\">30%</font>，移动力增加<font color=\"#ed7950\">1</font>格。<br />✦使用任意[<span style=\"display:inline;white-space:nowrap;\">魔药</span>]后获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"再生2\" class=\"bili-tt\"><font color=\"orange\">再生2</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"免伤1\" class=\"bili-tt\"><font color=\"orange\">免伤1</font></span></span>]，持续<font color=\"#ed7950\">3</font>回合。<br />✦进行物理攻击后，对目标施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼物防1\" class=\"bili-tt\"><font color=\"orange\">▼物防1</font></span></span>]，持续3回合。进行魔法攻击后，对目标施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼魔防1\" class=\"bili-tt\"><font color=\"orange\">▼魔防1</font></span></span>]，持续3回合。<br />✦战斗开始时，获得<font color=\"#ed7950\">1</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"昆恩之盾\" class=\"bili-tt\"><font color=\"#54b4db\">昆恩之盾</font></span></span>]。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"个性五星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/20/l6fgusj