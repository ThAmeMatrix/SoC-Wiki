%99%E7%90%86%E7%9A%84%E9%A6%99%E5%91%B3.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e2/mls9gqj1jdoqad7zu5jhyqx4b1l5ayx.png/120px-%E6%8A%80%E8%83%BD_%E6%96%99%E7%90%86%E7%9A%84%E9%A6%99%E5%91%B3.png 1.5x, https://patchwiki.biligame.com/images/llzj/e/e2/mls9gqj1jdoqad7zu5jhyqx4b1l5ayx.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />料理的香味\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:10%;\"><center><b>&#160;技能类别<br /></b>[职业技能]</center>\n</td>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\">&#160;\n<p>（被动）使[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"料理\" class=\"bili-tt\"><font color=\"#54b4db\">料理</font></span></span>]拥有光环，效果：使[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"料理\" class=\"bili-tt\"><font color=\"#54b4db\">料理</font></span></span>]范围<font color=\"#ed7950\">2</font>格己方攻防属性提高<font color=\"#ed7950\">10%</font>，敌人攻防属性降低<font color=\"#ed7950\">10%</font>。自身触发[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"料理\" class=\"bili-tt\"><font color=\"#54b4db\">料理</font></span></span>]效果时，获得<font color=\"#ed7950\">1</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"森西的满足\" class=\"bili-tt\"><font color=\"#54b4db\">森西的满足</font></span></span>]，并额外回复<font color=\"#58cb48\">1</font>点能量。\n</p>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div>\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E6%A3%AE%E8%A5%BF\" title=\"角色图鉴库/森西\"><img alt=\"头像 森西.png\" src=\"htt