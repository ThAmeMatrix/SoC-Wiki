%80%A7_%E5%86%B0%E5%8E%9F%E7%8B%BC.png 1.5x, https://patchwiki.biligame.com/images/llzj/0/0e/14kj6r240frfu73kp5d1bjp18lkquu3.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />兵虫\n</th>\n<td class=\"wiki-bot text-left\" style=\"width:55%;\">\n<p>✦被攻击后，若生命值小于<font color=\"#58cb48\">50%</font>，则受到[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"守护失效\" class=\"bili-tt\"><font color=\"#f3c156\">守护失效</font></span></span>]。<br />拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"自然守护\" class=\"bili-tt\"><font color=\"#f3c156\">自然守护</font></span></span>]，效果：<br />✦最终受到伤害降低<font color=\"#ed7950\">30%</font>。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:25%;\" rowspan=\"1\"><b>该特性属于</b><br /><div class=\"hero_box\">\n<div class=\"hero_img\"><a href=\"/llzj/%E9%AD%94%E7%89%A9%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%85%B5%E8%99%AB\" title=\"魔物图鉴库/兵虫\"><img alt=\"兵虫 像素模型.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/gx22y8yxjnt00rgb06j46tis7x2gmze.png/75px-%E5%85%B5%E8%99%AB_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" decoding=\"async\" loading=\"lazy\" width=\"75\" height=\"75\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/gx22y8yxjnt00rgb06j46tis7x2gmze.png/113px-%E5%85%B5%E8%99%AB_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png 1.5x, https://patchwiki.biligame.com/images/llzj/5/5d/gx22y8yxjnt00rgb06j46tis7x2gmze.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></div>\n</div>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20261022164202\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.048 seconds\nReal time usage: 0.078 seconds\nPreprocessor visited node count: 344/1000000\nPost‐expand include size: 6518/2097152 bytes\nTemplate argument size: 1415/2097152 bytes\nHighest expansion depth: 13/40\nExpensive parser function count