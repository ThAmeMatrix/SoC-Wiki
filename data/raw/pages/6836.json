zj/thumb/e/e0/1jutu7l3zqfx6qwlvrc650fms89e6tj.png/80px-%E6%8A%80%E8%83%BD_%E6%B5%81%E6%98%9F%E7%81%AB%E9%9B%A8.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e0/1jutu7l3zqfx6qwlvrc650fms89e6tj.png/120px-%E6%8A%80%E8%83%BD_%E6%B5%81%E6%98%9F%E7%81%AB%E9%9B%A8.png 1.5x, https://patchwiki.biligame.com/images/llzj/e/e0/1jutu7l3zqfx6qwlvrc650fms89e6tj.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />流星火雨\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-4\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓5-↑3\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（魔法伤害）选择目标地形格，对目标范围<font color=\"#ed7950\">2</font>格内所有敌人造成<font color=\"#d68fe2\">140%</font>[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"火属性\" class=\"bili-tt\"><font color=\"orange\">火属性</font></span></span>]范围伤害，并施加<font color=\"#ed7950\">1</font>次[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"点燃\" class=\"bili-tt\"><font color=\"orange\">点燃</font></span></span>]，使地形格变为[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"燃烧\" class=\"bili-tt\"><font color=\"orange\">燃烧</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。<br />✦攻击前，攻击提高<font color=\"#ed7950\">20%</font>。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-4 2.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/f7/r5rq1ipy9owdhal0ipxpvoch22d3447.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-4_2.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/f/f7/r5rq1ipy9owdhal0ipxpvoch22d3447.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%89%B9%E8%8E%89%E4%B8%9D\" title=\"角色图鉴库/特莉丝\"><img alt=\"头像 特莉丝.png\" src=\"https://patchwiki.biligame.com/images/llzj/1/1f/gpqvn0pzn481yc3i2kcq3py4j6cxyqb.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">特莉丝</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td>\n<td style=\"te