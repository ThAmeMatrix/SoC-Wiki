hp0wf6.png/80px-%E6%8A%80%E8%83%BD_%E6%8A%95%E6%8E%B7%E5%86%BB%E4%BC%A4%E7%93%B6.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e3/oi60az90n1sytgbgvq98msr51hp0wf6.png/120px-%E6%8A%80%E8%83%BD_%E6%8A%95%E6%8E%B7%E5%86%BB%E4%BC%A4%E7%93%B6.png 1.5x, https://patchwiki.biligame.com/images/llzj/e/e3/oi60az90n1sytgbgvq98msr51hp0wf6.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />冻伤瓶\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>1\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓8-↑4\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>1圈\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（穿透伤害）对目标地点<font color=\"#ed7950\">1</font>圈内所有敌人，造成其<font color=\"#ed7950\">10%</font>生命值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰属性\" class=\"bili-tt\"><font color=\"orange\">冰属性</font></span></span>][<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"穿透伤害\" class=\"bili-tt\"><font color=\"orange\">穿透伤害</font></span></span>]，并施加<font color=\"#ed7950\">1</font>次[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冻伤\" class=\"bili-tt\"><font color=\"orange\">冻伤</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-3 1圈.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/fqdgppb0d4105h1tmiqwd26o09ippa8.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-3_1%E5%9C%88.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/2/23/fqdgppb0d4105h1tmiqwd26o09ippa8.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%86%B0%E5%8E%9F%E5%8D%AB%E9%98%9F%E2%80%9C%E7%8B%82%E9%AC%83%E2%80%9D\" title=\"角色图鉴库/冰原卫队“狂鬃”\"><img alt=\"头像 冰原卫队“狂鬃”.png\" src=\"https://patchwiki.biligame.com/images/llzj/b/b1/qcoicifavog648b9pa6ekgbac3ejj81.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">冰原卫队“狂鬃”</font></div>\n</div><div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E4%B9%8C%E8%8E%89%E5%A8%85\" title=\"角色图鉴库/乌莉娅\"><img alt=\"头像 乌莉娅.png\" src=\"https://patchwiki.biligame.com/images/llzj/d/d3/4gxudq77xnlntmitcbxzlqhka07e7uf.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">乌莉娅</f