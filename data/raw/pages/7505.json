snm\" style=\"color: #a94442; border: 1px solid #5cb85c; padding: 5px; margin-bottom: 20px; border-radius: 4px;\">\n<ul><li>资源统计表主要记录每月获取的希望晶石、星铸残胚、领悟之力。</li></ul>\n</div>\n<table class=\"wikitable\" style=\"width:100%;max-width: 800px; margin:auto; text-align:center; table-layout:fixed; word-break:break-all; background:#fffaf5; border:1px solid #ffccbc; border-radius:8px; white-space:normal;\">\n<caption><div style=\"margin-top: 10px; margin-bottom: 10px; text-align: center; visibility: visible;\">\n<div style=\"display: inline-block; vertical-align: middle; width: 10px; visibility: visible;\">\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div></div>\n<div style=\"display: inline-block; vertical-align: middle; padding-left: 6px; padding-right: 6px; font-size: 17px; visibility: visible;\"><p style=\"visibility: visible;\"><strong style=\"visibility: visible;\">铃兰之剑资源统计2026/02</strong></p></div>\n<div style=\"display: inline-block; vertical-align: middle; width: 10px; visibility: visible;\">\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div></div></div>\n</caption>\n<tbody><tr>\n<th style=\"width:14%\">项目\n</th>\n<th style=\"width:12%\">希望晶石\n</th>\n<th style=\"width:9%\">秘缘\n</th>\n<th style=\"width:8%\">领悟之力\n</th>\n<th style=\"width:11%\">星铸残胚\n</th>\n<th style=\"width:16%\">晶石算法\n</th>\n<th style=\"width:30%\">备注\n</th></tr>\n<tr>\n<td>签到</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*100</td>\n<td>\n</td></tr>\n<tr>\n<td>日常任务</td>\n<td>1680</td>\n<td></td>\n<td></td>\n<td></td>\n<td>28*60</td>\n<td>\n</td></tr>\n<tr>\n<td>频道活跃</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*100</td>\n<td>4次周一\n</td></tr>\n<tr>\n<td>大月卡(免费)</td>\n<td>250</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>荣耀之战</td>\n<td>590</td>\n<td></td>\n<td>1</td>\n<td></td>\n<td>5*28+150+300</td>\n<td>日常奖励、活跃奖励、排名奖励\n</td></tr>\n<tr>\n<td>征服之塔</td>\n<td>1520</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*380</td>\n<td>4次周一\n</td></tr>\n<tr>\n<td>维护更新</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*150+100</td>\n<td>2次周四更新<br />2月13日临时维护100钻\n</td></tr>\n<tr>\n<td>角色试用</td>\n<td>450</td>\n<td></td>\n<td></td>\n<td></td>\n<td>3*150</td>\n<td>阿列克谢•风雪孤行150钻<br />萨曼莎•不灭微光150钻<br />罗格妮达150钻\n</td></tr>\n<tr>\n<td>春愿嘉礼</td>\n<td></td>\n<td>10</td>\n<td></td>\n<td>100</td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>至高悬赏</td>\n<td>500</td>\n<td></td>\n<td></td>\n<td>400</td>\n<td>100+60+70+80+90+100</td>\n<td>\n</td></tr>\n<tr>\n<td>激战乐团之夜</td>\n<td>1280</td>\n<td>3</td>\n<td>1</td>\n<td></td>\n<td>40*10+22*40</td>\n<td>浩海冒险10关<br />游园奇旅22关\n</td></tr>\n<tr>\n<td>圣杯的大秘宝</td>\n<td>895</td>\n<td></td>\n<td></td>\n<td></td>\n<td>125*7+20</td>\n<td>按平均每天125钻计算7天<br />分享奖励20钻\n</td></tr>\n<tr>\n<td>新年邮件</td>\n<td>300</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>2月17日新年邮件\n</td></tr>\n<tr>\n<td>高难愚者</td>\n<td>1200</td>\n<td></td>\n<td>2</td>\n<td></td>\n<td>50*7*2+400+100</td>\n<td>高难愚者四章&amp;五章<br />参与1次关卡挑战100钻\n</td></tr>\n<tr>\n<td>逆境之塔</td>\n<td>2100</td>\n<td></td>\n<td></td>\n<td>650</td>\n<td>300*7</td>\n<td>每层300钻*7\n</td></tr>\n<tr>\n<td>兑换码</td>\n<td>300</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>2月21日兑换码\n</td></tr>\n<tr>\n<td>人气投票</td>\n<td>200</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>第一阶段\n</td></tr>\n<tr style=\"background: #eee6dd;\">\n<td><b>总计</b></td>\n<td>12465</td>\n<td>13</td>