x -14px; box-sizing: border-box; visibility: visible;\">\n<div style=\"text-align: center; justify-content: center; margin: -22px 0% 10px; transform: translate3d(1px, 0px, 0px); display: flex; flex-flow: row nowrap; box-sizing: border-box; visibility: visible;\">\n<div style=\"display: inline-block; width: auto; vertical-align: middle; flex: 100 100 0%; height: auto; padding-right: 10px; padding-left: 10px; align-self: center; box-sizing: border-box; visibility: visible;\">\n<div style=\"justify-content: center; margin-right: 0%; margin-left: 0%; transform: translate3d(1px, 0px, 0px); display: flex; flex-flow: row nowrap; box-sizing: border-box; visibility: visible;\">\n<div style=\"display: inline-block; width: auto; vertical-align: top; min-width: 10%; max-width: 100%; flex: 0 0 auto; height: auto; background-color: rgb(243, 230, 204); border-style: solid; border-width: 1px; border-color: rgb(213, 196, 162); padding-right: 6px; padding-left: 6px; align-self: flex-start; box-sizing: border-box; visibility: visible;\">\n<div style=\"display: flex; flex-flow: row nowrap; margin: -1px 0%; justify-content: center; box-sizing: border-box; visibility: visible;\">\n<div style=\"display: inline-block; width: auto; vertical-align: middle; flex: 100 100 0%; align-self: center; height: auto; padding-right: 5px; padding-left: 5px; border-top: 2px solid rgb(243, 230, 204); border-top-left-radius: 0px; border-bottom: 2px solid rgb(243, 230, 204); border-bottom-right-radius: 0px; box-sizing: border-box; visibility: visible;\">\n<div style=\"margin-right: 0%; margin-left: 0%; box-sizing: border-box; visibility: visible;\">\n<div style=\"color: rgb(124, 110, 81); letter-spacing: 4px; box-sizing: border-box; visibility: visible;\">麦莎</div>\n</div></div></div></div></div></div></div>\n<div style=\"margin-right: 0%; margin-left: 0%; box-sizing: border-box; visibility: visible;\">\n<div style=\"font-size: 14px; color: rgb(62, 62, 62); text-align: center; box-sizing: border-box; visibility: visible;\"><p style=\"text-align: left; text-indent: 2em; box-sizing: border-box; visibility: visible;\"><span style=\"color: rgb(124, 110, 81); box-sizing: border-box; visibility: visible;\">善良活泼乐观坚强的少女佣兵，铃兰之剑佣兵团的初期人员，也是团长最初的伙伴和重要的支持者。</span></p><p style=\"box-sizing: border-box; visibility: visible;\"><br style=\"box-sizing: border-box; visibility: visible;\" data-filtered=\"filtered\" /></p><p style=\"text-align: left; text-indent: 2em; box-sizing: border-box; visibility: visible;\"><span style=\"color: rgb(124, 110, 81); box-sizing: border-box; visibility: visible;\">作为战争孤儿的少女曾四处流浪，直到被拉维耶收养定居小镇才有了自己的家。悲惨的童年并未抹去少女灿烂的笑容，乐观、坚强、对所有人都报以善意和信任的少女很快赢得了所有人的喜爱。为了保护大家，少女自愿拿起武器，加入了拉维耶建立的佣兵团。&#160;</span></p><p style=\"box-sizing: border-box; visibility: visible;\"><br style=\"box-sizing: border-box; visibility: visible;\" data-filtered=\"filtered\" /></p><p style=\"text-align: left; text-indent: 2em; box-sizing: border-box; visibility: visible;\"><span style=\"color: rgb(124, 110, 81); box-sizing: border-box; visibility: visible;\">麦莎坚信，只要不放弃希望，一切总会好起来的。</span></p>\n</div></div></div>\n</div>\n<p><br />\n<img alt=\"官方消息105.jpg\" src=\"https://patchwiki.biligame.com/images/llzj/4/45/o8pc9jhd9uxb68tqixeuvlto8dezfgo.jpg\" decoding=\"async\" loading=\"lazy\" width=\"1080\" height=\"1920\" data-file-width=\"1080\" data-file-height=\"1920\" />\n</p>\n<center><small>*图片内容仅供参考，实际效果以游戏内为准</small></center>\n<p><br />\n<img alt=\"官方消息104.gif\" src=\"https://patchwiki.biligame.com/images/llzj/4/4e/mqwclur2a71tay6w1t7e7sz1zexygzs.gif\" decoding=\"async\" loading=\"lazy\" width=\"1078\" height=\"490\" data-file-width=\"1078\" data-file-height=\"490\" />\n<br /><br />\n</p>\n</div>\n<div class=\"col-sm-3\"></div>\n</div>\n<!-- \nNewPP limit report\nCached time: 20261022163659\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.028 seconds\nReal time usage: 0.051 seconds\nPreprocessor visited node count: 11