6uz.png/80px-%E6%8A%80%E8%83%BD_%E5%93%90%E5%BD%93%EF%BC%81.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/d/d2/mcsgla21ndsmyfwh9j6n33u54xah6uz.png/120px-%E6%8A%80%E8%83%BD_%E5%93%90%E5%BD%93%EF%BC%81.png 1.5x, https://patchwiki.biligame.com/images/llzj/d/d2/mcsgla21ndsmyfwh9j6n33u54xah6uz.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />哐当！\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>普攻\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>远程、对单位、直击\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>2-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓5-↑3\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（普攻）单体攻击，造成<font color=\"#ed7950\">80%</font>魔攻值的物理伤害，<font color=\"#ed7950\">30%</font>概率施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"晕眩\" class=\"bili-tt\"><font color=\"orange\">晕眩</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 2-3 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/f6/ddwjxhsx96irclwdl7iayrjqpssh3a4.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_2-3_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/f/f6/ddwjxhsx96irclwdl7iayrjqpssh3a4.png 1.5x\" data-file-width=\"100\" data-file-height=\"100\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E8%B4%9D%E6%8B%89\" title=\"角色图鉴库/贝拉\"><img alt=\"头像 贝拉.png\" src=\"https://patchwiki.biligame.com/images/llzj/f/f8/8bxs90gczly5mm33ztadzac8vaqhyoa.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">贝拉</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n\n<!-- \nNewPP limit report\nCached time: 20261022163518\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.448 seconds\nReal time usage: 0.616 seconds\nPreprocessor visited node count: 9374/1000000\nPost‐expand include size: 160458/2097152 bytes\nTemplate argument size: 754