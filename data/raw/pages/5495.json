zj/thumb/4/43/tem8wsynierem7o31ao9g10gcoi7ubb.png/80px-%E6%8A%80%E8%83%BD_%E6%AD%BB%E4%BA%A1%E5%AE%A3%E5%91%8A.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/4/43/tem8wsynierem7o31ao9g10gcoi7ubb.png/120px-%E6%8A%80%E8%83%BD_%E6%AD%BB%E4%BA%A1%E5%AE%A3%E5%91%8A.png 1.5x, https://patchwiki.biligame.com/images/llzj/4/43/tem8wsynierem7o31ao9g10gcoi7ubb.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />死亡宣告\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>5\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓8-↑8\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓8-↑8\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（支援）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，对目标范围<font color=\"#ed7950\">3</font>格内所有敌人施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"黑羽\" class=\"bili-tt\"><font color=\"#54b4db\">黑羽</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合，并偷取目标<font color=\"#ed7950\">1</font>点能量、<font color=\"#ed7950\">2</font>个[<span style=\"display:inline;white-space:nowrap;\">增益</span>]。释放技能后，自身获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲伤害2\" class=\"bili-tt\"><font color=\"orange\">▲伤害2</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰铠\" class=\"bili-tt\"><font color=\"blue\">冰铠</font></span></span>]及[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"死亡宣告\" class=\"bili-tt\"><font color=\"#54b4db\">死亡宣告</font></span></span>]，所有效果持续<font color=\"#ed7950\">2</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-3 3.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/a/a3/gna3oc2cjl54ui7uiti4hvjxnhrilam.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-3_3.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/a/a3/gna3oc2cjl54ui7uiti4hvjxnhrilam.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%A6%AE%E8%92%82%E5%A8%85\" title=\"角色图鉴库/妮蒂娅\"><img alt=\"头像 妮蒂娅.png\" src=\"https://patchwiki.biligame.com/images/llzj/9/9b/bbr1nam50ur5ezs6v1pllugk3fbrudp.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">妮蒂娅</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: sp