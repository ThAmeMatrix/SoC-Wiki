zj/thumb/0/05/qu9dfrhp9u5b2od9xtc23fzr9a3r2df.png/80px-%E6%8A%80%E8%83%BD_%E5%B7%A8%E9%94%A4%E5%86%B2%E6%92%9E.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/0/05/qu9dfrhp9u5b2od9xtc23fzr9a3r2df.png/120px-%E6%8A%80%E8%83%BD_%E5%B7%A8%E9%94%A4%E5%86%B2%E6%92%9E.png 1.5x, https://patchwiki.biligame.com/images/llzj/0/05/qu9dfrhp9u5b2od9xtc23fzr9a3r2df.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />巨锤冲撞\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-4十字\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓1-↑1\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3*4\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，选择自身十字<font color=\"#ed7950\">4</font>格内任一地形格，进行[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"精准冲锋\" class=\"bili-tt\"><font color=\"#f3c156\">精准冲锋</font></span></span>]（不可穿透），对路径及其两侧敌人，造成<font color=\"#ed7950\">30%</font>伤害，击退<font color=\"#ed7950\">1</font>格（朝冲锋方向）。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-4十字 3*4.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/85/m9z4uney4grjokw283ekp61r23bqjez.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-4%E5%8D%81%E5%AD%97_3%2A4.png.jpeg\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"81\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/8/85/m9z4uney4grjokw283ekp61r23bqjez.png/120px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-4%E5%8D%81%E5%AD%97_3%2A4.png.jpeg 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/8/85/m9z4uney4grjokw283ekp61r23bqjez.png/160px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-4%E5%8D%81%E5%AD%97_3%2A4.png.jpeg 2x\" data-file-width=\"198\" data-file-height=\"200\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%85%89%E8%BE%89%E7%A6%81%E5%86%9B%E2%80%9C%E9%93%81%E5%8D%AB%E2%80%9D\" title=\"角色图鉴库/光辉禁军“铁卫”\"><img alt=\"头像 光辉禁军“铁卫”.png\" src=\"https://patchwiki.biligame.com/images/llzj/9/97/elbskb89irvhvcux3rlw3vvxx4nqhzh.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">光辉禁军“铁卫”</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div st