td>\n<td></td>\n<td></td>\n<td>5*100</td>\n<td>5次周一\n</td></tr>\n<tr>\n<td>大月卡(免费)</td>\n<td>250</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>荣耀之战</td>\n<td>605</td>\n<td></td>\n<td>1</td>\n<td></td>\n<td>5*31+150+300</td>\n<td>日常奖励、活跃奖励、排名奖励\n</td></tr>\n<tr>\n<td>征服之塔</td>\n<td>1900</td>\n<td></td>\n<td></td>\n<td></td>\n<td>5*380</td>\n<td>5次周一\n</td></tr>\n<tr>\n<td>维护更新</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>8月6日更新150钻<br />8月13日闪断50钻<br />8月20日更新150钻<br />8月27日闪断50钻\n</td></tr>\n<tr>\n<td>角色试用</td>\n<td>300</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*150</td>\n<td>安缇歌150钻<br />狄奥娜150钻\n</td></tr>\n<tr>\n<td>克莱雅皮肤</td>\n<td>150</td>\n<td></td>\n<td></td>\n<td></td>\n<td>3*50</td>\n<td>后15级免费档位\n</td></tr>\n<tr>\n<td>领地经营</td>\n<td>720</td>\n<td>9</td>\n<td>2</td>\n<td></td>\n<td>600+120</td>\n<td>领主之路6秘缘<br />活动任务3秘缘600钻<br />四周支援4*30钻\n</td></tr>\n<tr>\n<td>铸铃为谁而鸣</td>\n<td>160</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*40</td>\n<td>孤城血战13-16关40钻\n</td></tr>\n<tr>\n<td>至高悬赏</td>\n<td>500</td>\n<td></td>\n<td></td>\n<td>400</td>\n<td>400+100</td>\n<td>等级奖励400钻<br />活动页面100钻\n</td></tr>\n<tr>\n<td>圣杯的大秘保</td>\n<td>895</td>\n<td></td>\n<td></td>\n<td></td>\n<td>125*7+20</td>\n<td>按平均每天125钻计算7天\n<p>分享奖励20钻\n</p>\n</td></tr>\n<tr>\n<td>光影回廊</td>\n<td>1330</td>\n<td>3</td>\n<td>1</td>\n<td></td>\n<td>1210+3*40</td>\n<td>任务1210+3次周刷新任务40\n</td></tr>\n<tr>\n<td>晴空相伴礼</td>\n<td></td>\n<td>2</td>\n<td></td>\n<td></td>\n<td></td>\n<td>8.28-8.31奖励\n</td></tr>\n<tr style=\"background: #eee6dd;\">\n<td><b>总计</b></td>\n<td>9970</td>\n<td>14</td>\n<td>4</td>\n<td>400</td>\n<td></td>\n<td>26年8月共80.4抽\n</td></tr>\n<tr style=\"background: #eaecf0;\">\n<td colspan=\"7\"><b>其他项目</b>\n</td></tr>\n<tr>\n<td>记忆碎片换秘源</td>\n<td></td>\n<td>5</td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>远航-开拓季</td>\n<td>150</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>每升1级150钻\n</td></tr>\n<tr>\n<td>小月卡(付费)</t