zj/thumb/6/6c/8bkaif8zwn8hwllrt0vc46ihi2ckcf2.png/80px-%E6%8A%80%E8%83%BD_%E8%BF%99%E7%93%B6%E6%88%91%E8%AF%B7.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/6/6c/8bkaif8zwn8hwllrt0vc46ihi2ckcf2.png/120px-%E6%8A%80%E8%83%BD_%E8%BF%99%E7%93%B6%E6%88%91%E8%AF%B7.png 1.5x, https://patchwiki.biligame.com/images/llzj/6/6c/8bkaif8zwn8hwllrt0vc46ihi2ckcf2.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />这瓶我请\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>1次\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-5\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓8-↑8\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（穿透伤害）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，对目标地点范围<font color=\"#ed7950\">2</font>格内所有敌人，造成其<font color=\"#ed7950\">10%</font>生命值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰属性\" class=\"bili-tt\"><font color=\"orange\">冰属性</font></span></span>]穿透伤害，每回合最多使用1次。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-5 2.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/6/68/95fesyla6xktqfwq5xmuiz