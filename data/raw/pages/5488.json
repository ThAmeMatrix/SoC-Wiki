zj/thumb/1/16/92y2qmanvkedxf5pwyf5r5z35s8m1r9.png/80px-%E6%8A%80%E8%83%BD_%E5%87%9B%E5%86%AC%E5%90%B9%E6%81%AF.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/1/16/92y2qmanvkedxf5pwyf5r5z35s8m1r9.png/120px-%E6%8A%80%E8%83%BD_%E5%87%9B%E5%86%AC%E5%90%B9%E6%81%AF.png 1.5x, https://patchwiki.biligame.com/images/llzj/1/16/92y2qmanvkedxf5pwyf5r5z35s8m1r9.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />凛冬吹息\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>1\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（支援）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，获得[<span style=\"display:inline;white-space:nowrap;\">凛冬吹息</span>]，效果：[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"维持\" class=\"bili-tt\"><font color=\"#f3c156\">维持</font></span></span>]时消耗<font color=\"#ed7950\">2</font>点能量。释放或触发技能时施加敌人<font color=\"#ed7950\">1</font>次[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冻伤\" class=\"bili-tt\"><font color=\"orange\">冻伤</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合；若自身拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"物理护盾\" class=\"bili-tt\"><font color=\"orange\">物理护盾</font></span></span>]且目标受到[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼移动\" class=\"bili-tt\"><font color=\"orange\">▼移动</font></span></span>]，则再施加<font color=\"#ed7950\">1</font>次[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冻伤\" class=\"bili-tt\"><font color=\"orange\">冻伤</font></span></span>]。每次[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冻伤\" class=\"bili-tt\"><font color=\"orange\">冻伤</font></span></span>]对每个目标每回合最多生效1次。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-0 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/84/lekhjouylcdedt30jvnh0upev2fjg1n.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-0_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/8/84/lekhjouylcdedt30jvnh0upev2fjg1n.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%A6%AE%E8%92%82%E5%A8%85\" title=\"角色图鉴库/妮蒂娅\"><img alt=\"头像 妮蒂娅.png\" src=\"https://patchwiki.biligame.com/images/llzj/9/9b/bbr1nam50ur5ezs6v1pllugk3fbrudp.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"i