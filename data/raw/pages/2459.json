b5/9hm20wqmn7ph2gcqx5l6cy0zgizkd3m.png\" decoding=\"async\" loading=\"lazy\" width=\"90\" height=\"90\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:90px;\"><font color=\"#fff\">伊南娜</font></div>\n</div>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"天赋二星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/56px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/84px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/112px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>战斗开始时，召唤一名[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"王女亲卫\" class=\"bili-tt\"><font color=\"#54b4db\">王女亲卫</font></span></span>]。行动结束时，治疗自身范围<font color=\"red\">2</font>格内生命值最低的<font color=\"red\">1</font>名友方，治疗量为魔攻值的<font color=\"green\">20%</font>，获得随机<font color=\"red\">1</font>个[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"2级增益\" class=\"bili-tt\"><font color=\"orange\">2级增益</font></span></span>]，持续<font color=\"red\">2</font>回合。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"天赋三星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/56px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/84px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/112px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>战斗开始时，召唤一名[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"王女亲卫\" class=\"bili-tt\"><font color=\"#54b4db\">王女亲卫</font></span></span>]。行动结束时，治疗自身范围<font color=\"red\">3</font>格内生命值最低的<font color=\"red\">2</font>名友方，治疗量为魔攻值的<font color=\"green\">20%</font>，获得随机<font color=\"red\">1</font>个[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"2级增益\" class=\"bili-tt\"><font color=\"orange\">2级增益</font></span></span>]，持续<font color=\"red\">2</font>回合。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"天赋四星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/56px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/84px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/112px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>战斗开始时，召唤一名[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"王女亲卫\" class=\"bili-tt\"><font color=\"#54b4db\">王女亲卫</font></span></span>]。行动结束时，治疗自身范围<font color=\"red\">4</font>格内生命值最低的<font color=\"red\">2</font>名友方，治疗量为魔攻值的<font color=\"green\">25%</font>，获得随机<font color=\"red\">1</font>个[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"2级增益\" class=\"bili-tt\"><font color=\"orange\">2级增益</font></span></span>]，持续<font color=\"red\">2</font>回合。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"天赋五星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/b/bf/l6fg