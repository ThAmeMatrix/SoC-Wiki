snm\" style=\"color: #a94442; border: 1px solid #5cb85c; padding: 5px; margin-bottom: 20px; border-radius: 4px;\">\n<ul><li>资源统计表主要记录每月获取的希望晶石、星铸残胚、领悟之力。</li></ul>\n</div>\n<table class=\"wikitable\" style=\"width:100%;max-width: 800px; margin:auto; text-align:center; table-layout:fixed; word-break:break-all; background:#fffaf5; border:1px solid #ffccbc; border-radius:8px; white-space:normal;\">\n<caption><div style=\"margin-top: 10px; margin-bottom: 10px; text-align: center; visibility: visible;\">\n<div style=\"display: inline-block; vertical-align: middle; width: 10px; visibility: visible;\">\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div></div>\n<div style=\"display: inline-block; vertical-align: middle; padding-left: 6px; padding-right: 6px; font-size: 17px; visibility: visible;\"><p style=\"visibility: visible;\"><strong style=\"visibility: visible;\">铃兰之剑资源统计2026/04</strong></p></div>\n<div style=\"display: inline-block; vertical-align: middle; width: 10px; visibility: visible;\">\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div></div></div>\n</caption>\n<tbody><tr>\n<th style=\"width:14%\">项目\n</th>\n<th style=\"width:12%\">希望晶石\n</th>\n<th style=\"width:9%\">秘缘\n</th>\n<th style=\"width:8%\">领悟之力\n</th>\n<th style=\"width:11%\">星铸残胚\n</th>\n<th style=\"width:16%\">晶石算法\n</th>\n<th style=\"width:30%\">备注\n</th></tr>\n<tr>\n<td>签到</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*100</td>\n<td>\n</td></tr>\n<tr>\n<td>日常任务</td>\n<td>1800</td>\n<td></td>\n<td></td>\n<td></td>\n<td>30*60</td>\n<td>\n</td></tr>\n<tr>\n<td>频道活跃</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*100</td>\n<td>4次周一\n</td></tr>\n<tr>\n<td>大月卡(免费)</td>\n<td>250</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>荣耀之战</td>\n<td>600</td>\n<td></td>\n<td>1</td>\n<td></td>\n<td>5*30+150+300</td>\n<td>日常奖励、活跃奖励、排名奖励\n</td></tr>\n<tr>\n<td>征服之塔</td>\n<td>1520</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*380</td>\n<td>4次周一\n</td></tr>\n<tr>\n<td>维护更新</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>150*2+50+50</td>\n<td>2次周四维护更新<br />4月9日闪断50钻<br />4月23日闪断50钻\n</td></tr>\n<tr>\n<td>角色试用</td>\n<td>300</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*150</td>\n<td>芬恩150钻<br />塞娜150钻\n</td></tr>\n<tr>\n<td>猫爪打卡簿</td>\n<td></td>\n<td>10</td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>冰原之心(门内)</td>\n<td>480</td>\n<td></td>\n<td></td>\n<td></td>\n<td>12*40</td>\n<td>女神试炼9-20\n</td></tr>\n<tr>\n<td>乐土黄金杯</td>\n<td>950</td>\n<td>6</td>\n<td>1</td>\n<td></td>\n<td></td>\n<td>点金等阶800钻<br />回档补偿150钻\n</td></tr>\n<tr>\n<td>圣杯的大秘宝</td>\n<td>895</td>\n<td></td>\n<td></td>\n<td></td>\n<td>125*7+20</td>\n<td>按平均每天125钻计算7天\n<p>分享奖励20钻\n</p>\n</td></tr>\n<tr>\n<td>高难愚者</td>\n<td>1200</td>\n<td></td>\n<td>2</td>\n<td></td>\n<td>50*7*2+400+100</td>\n<td>高难愚者六章&amp;七章\n<p>参与1次关卡挑战100钻\n</p>\n</td></tr>\n<tr>\n<td>兑换码</td>\n<td>300</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>9x276fy9tz3ms\n</td></tr>\n<tr>\n<td>归来的铃兰</td>\n<td>1120</td>\n<td>3</td>\n<td>1</td>\n<td></td>\n<td>18*40+10*40=1120</td>\n<td>28个关卡\n</td></tr>\n<tr>\n<td>秘境探险</td>\n<td></td>\n<td>8</td>\n<td></td>\n<td>450</td>\n<td></td>\n<td>截止到30号只能获取8抽，剩8抽在5月\n</td></tr>\n<tr>\n<td>耕耘与收获</td>\n<td></td>\n<td>1</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4月30号1抽\n</td></tr>\n<tr style=\"background: #eee6dd;\">\n<td><b>总计</b></td>\n<td>10615</td>\n<td>28</td>\n<td>5</td>\n<td>450</td>\n<td></td>\n<td>26年4月共98.7抽\n</td></tr>\n<tr style=\"background: #eaecf0;\">\n<td colspan=\"7\"><b>其他项目</b>\n</td></tr>\n<tr>\n<td>记忆碎片换秘源</td>\n<td></td>\n<td>5</td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>远航-开拓季</td>\n<td>150</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>每升1级150钻\n</td></tr>\n<tr>\n<td>小月卡(付费)</td>\n<td>3000</td>\n<td></td>\n<td></td>\n<td></td>\n<td>30*80+600</td>\n<td>小月卡按平均一个月30天计算\n</td></tr>\n<tr>\n<td>大月卡(付费)</td>\n<td>800</td>\n<td></td>\n<td>1</td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>拂雪存忆</td>\n<td>80</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*40</td>\n<td>4月抽齐两个角色\n</td></tr>\n</tbody></table>\n<center><img alt=\"官方消息175.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/87/6oybbjhh7pbos7f5bxlnv0h1c4t8xie.png/560px-%E5%AE%98%E6%96%B9%E6%B6%88%E6%81%AF175.png\" decoding=\"async\" loading=\"lazy\" width=\"560\" height=\"75\" srcset=\"https://patchwiki.biligame.com/images/llzj/8/87/6oybbjhh7pbos7f5bxlnv0h1c4t8xie.png 1.5x\" data-file-width=\"750\" data-file-height=\"100\" /></center>\n<!-- \nNewPP limit report\nCached time: 20261022164238\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.028 seconds\nReal time usage: 0.051 seconds\nPreprocessor visited node count: 98/1000000\nPost‐expand include size: 2282/2097152 bytes\nTemplate argument size: 189/2097152 bytes\nHighest expansion depth: 5/40\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\nExtLoops count: 0\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   31.907      1 -total\n 52.15%   16.641      1 模板:面包屑\n 39.69%   12.664      1 模板:文章戳\n  7.59%    2.422      1 模板:注释\n-->\n\n<!-- Saved in parser cache with key gamecenter_wiki_llzj-pre_:pcache:idhash:8332-0!dateformat=default and timestamp 20261022164238 and revision id 214