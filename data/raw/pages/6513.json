zj/thumb/9/9a/2apiwc0w3sbysvn7s6ts9kk7qshsptc.png/80px-%E6%8A%80%E8%83%BD_%E8%8B%8D%E7%BF%A0%E6%97%8B%E5%BE%8B.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/9/9a/2apiwc0w3sbysvn7s6ts9kk7qshsptc.png/120px-%E6%8A%80%E8%83%BD_%E8%8B%8D%E7%BF%A0%E6%97%8B%E5%BE%8B.png 1.5x, https://patchwiki.biligame.com/images/llzj/9/9a/2apiwc0w3sbysvn7s6ts9kk7qshsptc.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />苍翠旋律\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>1\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>1\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（支援）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"苍翠旋律\" class=\"bili-tt\"><font color=\"#54b4db\">苍翠旋律</font></span></span>]，效果：[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"维持\" class=\"bili-tt\"><font color=\"#f3c156\">维持</font></span></span>]时消耗<font color=\"#ed7950\">1</font>点能量，期间获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"悦耳\" class=\"bili-tt\"><font color=\"#f3c156\">悦耳</font></span></span>]，且行动结束时，对自身范围<font color=\"#ed7950\">3</font>格所有己方治疗，治疗量为魔攻值的<font color=\"#58cb48\">20%</font>，并使其获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲暴击2\" class=\"bili-tt\"><font color=\"orange\">▲暴击2</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲暴伤1\" class=\"bili-tt\"><font color=\"orange\">▲暴伤1</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-0 3.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/a/ae/hp9k0iltoe2iq8n6u80ny5dwrlv7l6n.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-0_3.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/a/ae/hp9k0iltoe2iq8n6u80ny5dwrlv7l6n.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left; width:80px;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"skill_icon_box\">\n<div data-type=\"@悬浮框/技能2\" data-name=\"演奏\" class=\"bili-tt skill_icon_bg\"