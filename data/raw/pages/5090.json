A%E6%80%A7_%E7%8C%8E%E9%AD%94.png 1.5x, https://patchwiki.biligame.com/images/llzj/a/a9/jznwvawj6yv89sts1cq86zu2isszr9o.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />猎魔\n</th>\n<td class=\"wiki-bot text-left\" style=\"width:60%;\">&#160;<img alt=\"个性一星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/56px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/84px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/112px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"跳跃\" class=\"bili-tt\"><font color=\"orange\">跳跃</font></span></span>]，行动开始时获得<font color=\"#d68fe2\">150%</font>魔防值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"魔法护盾\" class=\"bili-tt\"><font color=\"orange\">魔法护盾</font></span></span>]。攻击时，自身[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"魔法护盾\" class=\"bili-tt\"><font color=\"orange\">魔法护盾</font></span></span>]值的<font color=\"#ed7950\">35%</font>附加在物攻上。<br />攻击前，目标每缺少<font color=\"#ed7950\">1</font>点能量，造成伤害提高<font color=\"#ed7950\">4%</font>，最多<font color=\"#ed7950\">12%</font>。对[<span style=\"display:inline;white-space:nowrap;\">魔攻值大于物攻值</span>]的角色进行非[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]的单体主动攻击时，消除目标<font color=\"#ed7950\">1</font>点能量，并额外造成<font color=\"#ed7950\">30%</font>物攻值的物理伤害。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:20%;\" rowspan=\"5\"><b>该个性属于</b><br /><br /><div class=\"hero_head\" style=\"width:90px;height:90px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E4%BC%8A%E6%96%AF%E7%89%B9%E6%8B%89\" title=\"角色图鉴库/伊斯特拉\"><img alt=\"头像 伊斯特拉.png\" src=\"https://patchwiki.biligame.com/images/llzj/a/a1/exyu9a6bjlcha6astjdd7ktubrm3yp7.png\" decoding=\"async\" loading=\"lazy\" width=\"90\" height=\"90\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:90px;\"><font color=\"#fff\">伊斯特拉</font></div>\n</div>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"个性二星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e0/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/56px-%E4%B8%AA%E6%80%A7%E4%BA%8C%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e0/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/84px-%E4%B8%AA%E6%80%A7%E4%BA%8C%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/e/e0/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/112px-%E4%B8%AA%E6%80%A7%E4%BA%8C%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"跳跃\" class=\"bili-tt\"><font color=\"orange\">跳跃</font></span></span>]，行动开始时获得<font color=\"#d68fe2\">150%</font>魔防值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"魔法护盾\" class=\"bili-tt\"><font color=\"orange\">魔法护盾</font></span></span>]。攻击时，自身[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"魔法护盾\" class=\"bili-tt\"><font color=\"orange\">魔法护盾</font></span></span>]值的<font color=\"#ed7950\">35%</font>附加在物攻上。<br />攻击前，目标每缺少<font color=\"#ed7950\">1</font>点能量，造成伤害提高<font color=\"#ed7950\">5%</font>，最多<font color=\"#ed7950\">15%</font>。攻击没有能量的目标时，物攻额外提高<font color=\"#ed7950\">10%</font>。对[<span style=\"display:inline;white-space:nowrap;\">魔攻值大于物攻值</span>]的角色进行非[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]的单体主动攻击时，消除目标<font color=\"#ed7950\">1</font>点能量，并额外造成<font color=\"#ed7950\">30%</font>物攻值的物理伤害。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"个性三星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/0/07/czx3heixk04558ia8wj7hpokhzl5cbx.png/56px-%E4%B8%AA%E6%80%A7%E4%B8%89%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/0/07/czx3heixk04558ia8wj7hpokhzl5cbx.png/84px-%E4%B8%AA%E6%80%A7%E4%B8%89%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/0/07/czx3heixk04558ia8wj7hpokhzl5cbx.png/112px-%E4%B8%AA%E6%80%A7%E4%B8%89%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"跳跃\" class=\"bili-tt\"><font color=\"orange\">跳跃</font></span></span>]，行动开始时获得<font color=\"#d68fe2\">150%</font>魔防值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"魔法护盾\" class=\"bili-tt\"><font color=\"orange\">魔法护盾</font></span></span>]。攻击时，自身[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"魔法护盾\" class=\"bili-tt\"><font color=\"orange\">魔法护盾</font></span></span>]值的<font color=\"#ed7950\">35%</font>附加在物攻上。<br />攻击前，目标每缺少<font color=\"#ed7950\">1</font>点能量，造成伤害提高<font color=\"#ed7950\">6%</font>，最多<font color=\"#ed7950\">18%</font>。攻击没有能量的目标时，物攻额外提高<font color=\"#ed7950\">10%</font>。对[<span style=\"display:inline;white-space:nowrap;\">魔攻值大于物攻值</span>]的角色进行非[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">