{"parse":{"title":"个性/血律强权","pageid":8534,"revid":21534,"text":"<div class=\"mw-parser-output\"><p><br />\n</p><p><br />\n</p>\n<div id=\"bread-edit\" class=\"bread-edit\" style=\"float:right;margin-top:10px;margin-right:10px\"><sup><a rel=\"nofollow\" class=\"external text\" href=\"https://wiki.biligame.com/llzj/index.php?title=%E4%B8%AA%E6%80%A7/%E8%A1%80%E5%BE%8B%E5%BC%BA%E6%9D%83&amp;action=edit\">编</a></sup> <sup><a rel=\"nofollow\" class=\"external text\" href=\"https://wiki.biligame.com/llzj/index.php?title=%E4%B8%AA%E6%80%A7/%E8%A1%80%E5%BE%8B%E5%BC%BA%E6%9D%83&amp;action=purge\">刷</a></sup> <sup><a rel=\"nofollow\" class=\"external text\" href=\"https://wiki.biligame.com/llzj/index.php?title=%E4%B8%AA%E6%80%A7/%E8%A1%80%E5%BE%8B%E5%BC%BA%E6%9D%83&amp;action=history\">历</a></sup></div>\n<div style=\"padding: 5px 10px;margin: 10px 0;border: 1px solid #ebccd1;border-left-width: 5px;border-radius: 3px;background: rgb(255 255 255 / 40%);\">\n<a href=\"/llzj/%E9%A6%96%E9%A1%B5\" title=\"首页\">首页</a> &gt; <a href=\"/llzj/%E6%8A%80%E8%83%BD%E5%9B%BE%E9%89%B4%E5%BA%93\" title=\"技能图鉴库\">技能图鉴库</a> &gt; <b>血律强权</b><br /></div>\n<hr />\n<h2><span id=\".E8.A1.80.E5.BE.8B.E5.BC.BA.E6.9D.83\"></span><span class=\"mw-headline\" id=\"血律强权\"><b>血律强权</b></span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/llzj/index.php?title=%E6%A8%A1%E6%9D%BF:%E4%B8%AA%E6%80%A7&amp;action=edit&amp;section=T-1\" title=\"编辑章节：\">编辑</a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n\n<tbody><tr>\n<th colspan=\"3\">个性详情\n</th></tr>\n<tr>\n<th class=\"text-nowrap\" style=\"width:20%;\" rowspan=\"5\"><img alt=\"个性 血律强权.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/f0/9e3p87b6n3tbqofqhjk9hek76a8loqf.png/80px-%E4%B8%AA%E6%80%A7_%E8%A1%80%E5%BE%8B%E5%BC%BA%E6%9D%83.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"http