nxnw.png/80px-%E6%8A%80%E8%83%BD_%E9%80%9A%E7%BC%89%E4%BB%A4.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/e/ed/rw6thysdabkes1v49xtonoszbjcnxnw.png/120px-%E6%8A%80%E8%83%BD_%E9%80%9A%E7%BC%89%E4%BB%A4.png 1.5x, https://patchwiki.biligame.com/images/llzj/e/ed/rw6thysdabkes1v49xtonoszbjcnxnw.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />通缉令\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位、曲射\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-5\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓8-↑8\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（治疗）对目标施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"倒吊人标记\" class=\"bili-tt\"><font color=\"orange\">倒吊人标记</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼速度2\" class=\"bili-tt\"><font color=\"orange\">▼速度2</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合，治疗目标范围<font color=\"#ed7950\">4</font>格内所有友军，治疗量为魔攻值的<font color=\"#58cb48\">65%</font>，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲移动1\" class=\"bili-tt\"><font color=\"orange\">▲移动1</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-5 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/9/95/at4dr45s2ma4cti9dv4gkekpa78egvl.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-5_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/9/95/at4dr45s2ma4cti9dv4gkekpa78egvl.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%80%92%E5%90%8A%E4%BA%BA%E2%80%9C%E7%83%9B%E7%81%AB%E2%80%9D\" title=\"角色图鉴库/倒吊人“烛火”\"><img alt=\"头像 倒吊人“烛火”.png\" src=\"https://patchwiki.biligame.com/images/llzj/9/94/ftyl98jhxinnwjhwhlbnujtjca4mcl5.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">倒吊人“烛火”</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-conte