td>\n<td></td>\n<td></td>\n<td>4*100</td>\n<td>4次周一\n</td></tr>\n<tr>\n<td>大月卡(免费)</td>\n<td>250</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>荣耀之战</td>\n<td>600</td>\n<td></td>\n<td>1</td>\n<td></td>\n<td>5*30+150+300</td>\n<td>日常奖励、活跃奖励、排名奖励\n</td></tr>\n<tr>\n<td>征服之塔</td>\n<td>1520</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*380</td>\n<td>4次周一\n</td></tr>\n<tr>\n<td>维护更新</td>\n<td>650</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>9月3日更新150钻<br />9月10日闪断50钻<br />9月17日更新150钻<br />9月22日审判塔罗优化150钻<br />9月24日更新150钻\n</td></tr>\n<tr>\n<td>角色试用</td>\n<td>300</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*150</td>\n<td>Sp卡丽丝150钻<br />萨曼莎·审判150钻\n</td></tr>\n<tr>\n<td>光影回廊</td>\n<td>80</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*40</td>\n<td>2次周刷新任务40钻\n</td></tr>\n<tr>\n<td>晴空相伴礼</td>\n<td></td>\n<td>8</td>\n<td></td>\n<td></td>\n<td></td>\n<td>9.1之后奖励\n</td></tr>\n<tr>\n<td>逆境之塔</td>\n<td>2100</td>\n<td></td>\n<td></td>\n<td>650</td>\n<td>300*7</td>\n<td>每层300钻*7\n</td></tr>\n<tr>\n<td>兑换码</td>\n<td>600</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>47tts8tyyuhss<br />MOONCAKE2026\n</td></tr>\n<tr>\n<td>高难愚者8-9章</td>\n<td>1200</td>\n<td></td>\n<td>2</td>\n<td></td>\n<td>14*50+400+100</td>\n<td>8-9章共14关50钻<br />星级奖励400钻+活动页面100钻<br />1自选专武\n</td></tr>\n<tr>\n<td>乐土奇货集</td>\n<td>850</td>\n<td></td>\n<td></td>\n<td>100</td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>审判之日</td>\n<td>1280</td>\n<td></td>\n<td></td>\n<td></td>\n<td>20*40+4*40+4*80</td>\n<td>剧情20关*40钻(有4关无钻)<br />圣殿决战4关*40钻<br />剧情成就4*80钻\n</td></tr>\n<tr>\n<td>余烬长路</td>\n<td>360</td>\n<td>2</td>\n<td>1</td>\n<td></td>\n<td>7*40+2*40</td>\n<td>长路见证1秘缘+7*40钻+1领悟力<br />行迹等级1秘缘<br />成就2*40钻\n</td></tr>\n<tr>\n<td>命运印记(成就)</td>\n<td>675</td>\n<td></td>\n<td></td>\n<td></td>\n<td>27*25</td>\n<td>27个成就\n</td></tr>\n<tr>\n<td>征服之塔(高难)</td>\n<td>100</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>蔻蔻娜的食光盛宴</td>\n<td>240</td>\n<td></td>\n<td></td>