tneo43aobr0kisd0zoh.png/65px-%E6%8A%80%E8%83%BD%E8%83%8C%E6%99%AF_%E5%8F%B2%E8%AF%97.png\" decoding=\"async\" loading=\"lazy\" width=\"65\" height=\"65\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/7/7b/bdxsswq2neqstneo43aobr0kisd0zoh.png/98px-%E6%8A%80%E8%83%BD%E8%83%8C%E6%99%AF_%E5%8F%B2%E8%AF%97.png 1.5x, https://patchwiki.biligame.com/images/llzj/7/7b/bdxsswq2neqstneo43aobr0kisd0zoh.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></div>\n    <div data-type=\"@悬浮框/极限解放\" data-name=\"不破钢铁之志\" class=\"bili-tt gx_img\"><a href=\"/llzj/%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE/%E4%B8%8D%E7%A0%B4%E9%92%A2%E9%93%81%E4%B9%8B%E5%BF%97\" title=\"极限解放/不破钢铁之志\"><img alt=\"极限解放 不破钢铁之志.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/8b/5a7kvz9mk6t9okpll1rfmhsw1knwujf.png/65px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E4%B8%8D%E7%A0%B4%E9%92%A2%E9%93%81%E4%B9%8B%E5%BF%97.png\" decoding=\"async\" loading=\"lazy\" width=\"65\" height=\"65\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/8/8b/5a7kvz9mk6t9okpll1rfmhsw1knwujf.png/98px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E4%B8%8D%E7%A0%B4%E9%92%A2%E9%93%81%E4%B9%8B%E5%BF%97.png 1.5x, https://patchwiki.biligame.com/images/llzj/8/8b/5a7kvz9mk6t9okpll1rfmhsw1knwujf.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></div>\n    <div class=\"gx_name\"><a href=\"/llzj/%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE/%E4%B8%8D%E7%A0%B4%E9%92%A2%E9%93%81%E4%B9%8B%E5%BF%97\" title=\"极限解放/不破钢铁之志\"><font color=\"#FFF\">不破钢铁之志</font></a></div>\n    </div>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:15%;\">关联内容\n</th>\n<td style=\"text-align:left\">\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">角色绰号\n</th>\n<td>暂无\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配置推荐\n</th>\n<td>如下\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色攻略\n</th>\n<td>【by Azhar-_-】<a rel=\"nofollow\" class=\"external free\" href=\"https://m.bilibili.com/video/BV1zuuY6mELQ\">https://m.bilibili.com/video/BV1zuuY6mELQ</a>\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">中文CV\n</th>\n<td>张琦\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">日文CV\n</th>\n<td>稻垣好\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配音展示\n</th>\n<td>【by ThAmeReborn】<a rel=\"nofollow\" class=\"external free\" href=\"https://m.bilibili.com/video/BV1cDux6qE6f\">https://m.bilibili.com/video/BV1cDux6qE6f</a>\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色生平\n</th>\n<td>身残志坚的纤弱贵族少女，擅长蛰伏与谋略。<br />\n<p>安缇歌出身北境领主家族，年少时亲眼见证父亲推行改革失败，也亲历了家族在阴谋与“天罚”谎言中走向破灭。那场灾祸不仅夺走了她的亲人，也让她落下了长期折磨身心的后遗症。自那之后，安缇歌便以柔弱沉静的外表掩藏锋芒，在病痛与屈辱中长久隐忍，等待亲手清算旧账的时机。<br />\n比起神明、教义和高高在上的权威，安缇歌更相信人的意志与选择。她看透了教权与权力如何借信仰之名操纵人心，也因此对一切冠冕堂皇的话语始终保持警惕。可在那份近乎冷酷的清醒之下，她依然没有放弃对“改变”本身的期待。正因如此，当她遇见仍愿为民众寻找新路的克莱雅时，才会在怀疑与试探之后，选择将自己最后的筹码押上那条危机重重的道路……\n</p>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width: 100%;\">\n<tbody><tr>\n<th>角色像素模型\n</th></tr>\n<tr>\n<td style=\"text-align: center; width: 50%;\"><a href=\"/llzj/%E6%96%87%E4%BB%B6:%E5%AE%89%E7%BC%87%E6%AD%8C_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" class=\"image\"><img alt=\"安缇歌 像素模型.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/8d/j6zxk9dp8mn2y8gf2jq4jmjpwe7ypel.png/100px-%E5%AE%89%E7%BC%87%E6%AD%8C_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"100\" srcset=\"https://patchwiki.biligame.com/images/llzj/8/8d/j6zxk9dp8mn2y8gf2jq4jmjpwe7ypel.png 1.5x\" data-file-width=\"128\" data-file-height=\"128\" /></a>\n</td></tr>\n</tbody></table></div></div></div>\n<!-- \nNewPP limit report\nCached time: 20261022140611\nCache expiry: 86400\nReduced expiry: false\nCom