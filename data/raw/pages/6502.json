9); width:28px; height:28px; display:flex; justify-content:center\">\n<img src=\"https://patchwiki.biligame.com/images/llzj/8/86/a28jupdnch4m4ux4kcygr3sww8fmi9l.png\">\n</div>\n&nbsp;物防&nbsp;<span data-bind=\"text: 物防\"></span>\n</div>\n<div style=\"height:35px; width:48%; display:flex; justify-content:flex-start; align-items:center\">\n<div style=\"background-color:rgb(118 103 79); width:28px; height:28px; display:flex; justify-content:center\">\n<img src=\"https://patchwiki.biligame.com/images/llzj/9/9e/nx1g7z11c67ttcj9zkhysaajpbjsqbg.png\">\n</div>\n&nbsp;魔防&nbsp;<span data-bind=\"text: 魔防\"></span>\n</div>\n</div>\n\n<div>&nbsp;</div>\n\n<div style=\"display:flex; justify-content:space-around\">\n<div style=\"height:35px; width:48%; display:flex; justify-content:flex-start; align-items:center\">\n<div style=\"background-color:rgb(118 103 79); width:28px; height:28px; display:flex; justify-content:center\">\n<img src=\"https://patchwiki.biligame.com/images/llzj/6/61/3wiqk8zykmdnzzxx8tyoj9lualhyggu.png\">\n</div>\n&nbsp;生命&nbsp;<span data-bind=\"text: 生命\"></span>\n</div>\n<div style=\"height:35px; width:48%; display:flex; justify-content:flex-start; align-items:center\">\n<div style=\"width:28px; height:28px; display:flex; justify-content:center\">\n</div>\n</div>\n</div>\n\n</body>\n\n<script src=\"https://wiki.biligame.com/ys/MediaWiki:Knockout.js?action=raw&ctype=text/javascript\"></script>\n<script>\ndata_table={\nsword_sr:[26,0,12,6,70,4.44,0,1.62,1.12,11,8.4,0,3,2,21.9]\n};\n\nfunction selectmousedown(ev) {\n  if (ev.options.length > 5) {\n    ev.size = 6;\n    $(ev).css({\n      \"height\": \"auto\",\n      \"position\": \"absolute\"\n    })\n  } else {\n    $(ev).css(\"height\", \"28px\")\n  }\n}\n\nfunction selectblur(ev) {\n  ev.size = 0;\n  $(ev).css({\n    \"height\": \"28px\",\n    \"width\": \"50px\",\n    \"position\": \"static\"\n  })\n}\n\nfunction selectchange(ev) {\n  ev.size = 0;\n  $(ev).css({\n    \"height\": \"28px\",\n    \"width\": \"50px\",\n    \"position\": \"static\"\n  })\n}\n\nfunction viewModel() {\n    var self = this;\n    self.等级 = ko.observable();\n    self.星级 = ko.observable();\n    self.分类 = document.getElementById(\"PNN\").innerHTML;\n    self.data = data_table[self.分类]\n    \n    <!-- self.物攻 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[5] + self.data[0] + (Number(self.星级())-1)*self.data[10]);\n  }); \n    self.魔攻 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[6] + self.data[1] + (Number(self.星级())-1)*self.data[11]);\n  }); \n    self.物防 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[7] + self.data[2] + (Number(self.星级())-1)*self.data[12]);\n  }); \n    self.魔防 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[8] + self.data[3] + (Number(self.星级())-1)*self.data[13]);\n  }); \n    self.生命 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[9] + self.data[4] + (Number(self.星级())-1)*self.data[14]);\n  }); --> \n}\n\nko.applyBindings(new viewModel());\n</script>\n</td></tr>\n<tr>\n<td>来源：邂逅星铸神兵池、装备商店兑换星铸神兵·余音、丰饶商店兑换星铸定影·余音\n</td>\n<td>*<small>特别声明：目前计算公式还在推算中，个别数值会与真实值存在差别。</small>\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%; background:none\">\n<tbody><tr>\n<td rowspan=\"5;\" width=\"10%\"><center><b>装<br />备<br />技<br />能</b><br /><br /></center>\n</td>\n<td><img alt=\"天赋一星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/1/10/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/70px-%E5%A4%A9%E8%B5%8B%E4%B8%80%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"18\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/1/10/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/105px-%E5%A4%A9%E8%B5%8B%E4%B8%80%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/1/10/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/140px-%E5%A4%A9%E8%B5%8B%E4%B8%80%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />\n<p>✦治疗时，魔攻提高<font color=\"#d68fe2\">3%</font>；对敌人治疗时魔攻额外提高<font color=\"#d68fe2\">3%</font>。<br />✦主动治疗敌人后，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"余音不绝1\" class=\"bili-tt\"><font color=\"#54b4db\">余音不绝1</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合，效果触发后冷却<font color=\"#ed7950\">4</font>回合，预冷却<font color=\"#ed7950\">1</font>回合。\n<br /><br />\n</p>\n</td></tr>\n<tr>\n<td><img alt=\"天赋二星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/70px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"18\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/105px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/140px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />\n<p>✦治疗时，魔攻提高<font color=\"#d68fe2\">4%</font>；对敌人治疗时魔攻额外提高<font color=\"#d68fe2\">4%</font>。<br />✦主动治疗敌人后，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"余音不绝1\" class=\"bili-tt\"><font color=\"#54b4db\">余音不绝1</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合，效果触发后冷却<font color=\"#ed7950\">4</font>回合，预冷却<font color=\"#ed7950\">1</font>回合。\n<br /><br />\n</p>\n</td></tr>\n<tr>\n<td><img alt=\"天赋三星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/70px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"18\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/105px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/140px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />\n<p>✦治疗时，魔攻提高<font color=\"#d68fe2\">4%</font>；对敌人治疗时魔攻额外提高<font color=\"#d68fe2\">4%</font>。<br />✦主动治疗敌人后，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"余音不绝1\" class=\"bili-tt\"><font color=\"#54b4db\">余音不绝1</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合，效果触发后冷却<font color=\"#ed7950\">4</font>回合。\n<br /><br />\n</p>\n</td></tr>\n<tr>\n<td><img alt=\"天赋四星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/70px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"18\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/105px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/140px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />\n<p>✦治疗时，魔攻提高<font color=\"#d68fe2\">5%</font>；对敌人治疗时魔攻额外提高<font color=\"#d68fe2\">5%</font>。<br />✦主动治疗敌人后，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"余音不绝1\" class=\"bili-tt\"><font color=\"#54b4db\">余音不绝1</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合，效果触发后冷却<font color=\"#ed7950\">3</font>回合。\n<br /><br />\n</p>\n</td></tr>\n<tr>\n<td><img alt=\"天赋五星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/b/bf/l6fgusj2lxp7caktkwbmf1ioo2m7utz.png/70px-%E5%A4%A9%E8%B5%8B%E4%BA%94%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"18\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/b/bf/l6fgusj2lxp7caktkwbmf1ioo2m7utz.png/105px-%E5%A4%A9%E8%B5%8B%E4%BA%94%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/b/bf/l6fgusj2lxp7caktkwbmf1ioo2m7utz.png/140px-%E5%A4%A9%E8%B5%8B%E4%BA%94%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />\n<p>✦治疗时，魔攻提高<font color=\"#d68fe2\">6%</font>；对敌人治疗时魔攻额外提高<font color=\"#d68fe2\">6%</font>。<br />✦主动治疗敌人后，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"余音不绝2\" class=\"bili-tt\"><font color=\"#54b4db\">余音不绝2</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合。\n<br /><br />\n</p>\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\" style=\"display:flex; justify-content:space-around\">\n<table class=\"wikitable\" style=\"width:100%; background:none\">\n\n<tbody><tr>\n<td><center><b>装备描述</b></center>\n</td>\n<td>琴身取白薇尔塔山巅的焦木，弦丝由埃拉曼最好的工匠鞣制，轻拨如林间静流，疾奏有风雷之势。\n</td></tr>\n<tr>\n<td><center><b>装备评价</b></center>\n</td>\n<td>\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\" style=\"display:flex; justify-content:space-around\">\n<table class=\"wikitable\" style=\"width:100%; background:none\">\n\n<tbody><tr>\n<td><center><b>适合角色</b></center>\n</td></tr>\n<tr>\n<td>赫砂\n</td></tr></tbody></table>\n</div>\n</div>\n</div>\n</div></div>\n\n<!-- \nNewPP limit report\nCached time: 20261022141831\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.084 seconds\nReal time usage: 0.146 seconds\nPreprocessor visited node count: 744/1000000\nPost‐expand include size: 18751/2097152 bytes\nTemplate argument size: 6679/2097152 bytes\nHighest expansion depth: 13/40\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\nExtLoops count: 0\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  108.175      1 模板:装备\n100.00%  108.175      1 -total\n 50.23%   54.332      5 模板:中括号介绍化\n 44.67%   48.317      5 模板:中括号介绍\n 23.15%   25.044      1 模板:面包屑\n  6.30%    6.810      4 模板:板块\n-->\n\n<!-- Saved 