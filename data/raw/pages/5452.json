zj/thumb/0/07/7h0v9rvo7dxjdw3ivcsqb9a91cj3hl4.png/80px-%E6%8A%80%E8%83%BD_%E4%BE%BF%E6%8D%B7%E8%B7%AF%E7%BA%BF.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/0/07/7h0v9rvo7dxjdw3ivcsqb9a91cj3hl4.png/120px-%E6%8A%80%E8%83%BD_%E4%BE%BF%E6%8D%B7%E8%B7%AF%E7%BA%BF.png 1.5x, https://patchwiki.biligame.com/images/llzj/0/07/7h0v9rvo7dxjdw3ivcsqb9a91cj3hl4.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />便捷路线\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（支援）使自身范围<font color=\"#ed7950\">3</font>格内所有己方获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲移动1\" class=\"bili-tt\"><font color=\"orange\">▲移动1</font></span></span>]，并免疫[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼移动\" class=\"bili-tt\"><font color=\"orange\">▼移动</font></span></span>]系列，所有效果持续回合；拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"魔力充沛\" class=\"bili-tt\"><font color=\"#54b4db\">魔力充沛</font></span></span>]时，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲移动2\" class=\"bili-tt\"><font color=\"orange\">▲移动2</font></span></span>]，并免疫[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰冻\" class=\"bili-tt\"><font color=\"orange\">冰冻</font></span></span>]和[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"燃烧\" class=\"bili-tt\"><font color=\"orange\">燃烧</font></span></span>]地形效果。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-0 3.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/a/ae/hp9k0iltoe2iq8n6u80ny5dwrlv7l6n.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-0_3.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/a/ae/hp9k0iltoe2iq8n6u80ny5dwrlv7l6n.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%8E%9B%E9%9C%B2%E8%A5%BF%E5%B0%94\" title=\"角色图鉴库/玛露西尔\"><img alt=\"头像 玛露西尔.png\" src=\"https://patchwiki.biligame.com/images/llzj/1/11/6y6wet22qlt8qr0hdg807eltm35jjql.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">玛露西尔</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;widt