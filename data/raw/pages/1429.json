zj/thumb/5/50/881t85crq4kxcmn7p00q1hxnefdge7w.png/80px-%E6%8A%80%E8%83%BD_%E8%AD%A6%E6%88%92%E5%B0%84%E5%87%BB.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/50/881t85crq4kxcmn7p00q1hxnefdge7w.png/120px-%E6%8A%80%E8%83%BD_%E8%AD%A6%E6%88%92%E5%B0%84%E5%87%BB.png 1.5x, https://patchwiki.biligame.com/images/llzj/5/50/881t85crq4kxcmn7p00q1hxnefdge7w.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />警戒射击\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-3十字\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓5-↑5\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3X3内\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓5-↑5\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）对目标方向<font color=\"red\">3×3</font>区域进行[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"警戒\" class=\"bili-tt\"><font color=\"orange\">警戒</font></span></span>]，可造成<font color=\"red\">100%</font>伤害，每回合最多发动<font color=\"red\">2</font>次。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-3十字 3X3内.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/83/8tmr3u70kqrg3oypy9j6xz1z932k4mx.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-3%E5%8D%81%E5%AD%97_3X3%E5%86%85.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height