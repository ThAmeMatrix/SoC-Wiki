%BC%E5%95%AA%E7%88%86%E7%81%AB%E8%8A%B1.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e7/q4wqb1q13jla680vh1mkdv5202l8p8y.png/120px-%E6%8A%80%E8%83%BD_%E5%99%BC%E5%95%AA%E7%88%86%E7%81%AB%E8%8A%B1.png 1.5x, https://patchwiki.biligame.com/images/llzj/e/e7/q4wqb1q13jla680vh1mkdv5202l8p8y.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />噼啪爆火花\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:10%;\"><center><b>&#160;技能类别<br /></b>[职业技能]</center>\n</td>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\">&#160;\n<p>（被动）释放[<span style=\"display:inline;white-space:nowrap;\">职业技能</span>]攻击后获得<font color=\"#ed7950\">2</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"炸毛\" class=\"bili-tt\"><font color=\"#54b4db\">炸毛</font></span></span>]。造成碰撞伤害时，对碰撞双方范围<font color=\"#ed7950\">1</font>圈内所有敌人，造成施法者<font color=\"#ed7950\">25%</font>物攻值的范围物理伤害。对免疫击退的目标攻击提高<font color=\"#ed7950\">15%</font>，攻击前施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼物防2\" class=\"bili-tt\"><font color=\"orange\">▼物防2</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼魔防2\" class=\"bili-tt\"><font color=\"orange\">▼魔防2</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。\n</p>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div>\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E9%BB%8E%E5%90%84\" title=\"角色图鉴库/黎各\"><img alt=\"头像 黎各.png\" src=\"https://patchwiki.biligame.com/images/llzj/5/50/g7oyfmhkv95nz1i4nhnv75z7rgcz678.png\"