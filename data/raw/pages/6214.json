A%E6%80%A7_%E5%99%A9%E9%AA%B8.png 1.5x, https://patchwiki.biligame.com/images/llzj/a/a0/55law51grkn5fy997aegzj1k7ocg258.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />噩骸\n</th>\n<td class=\"wiki-bot text-left\" style=\"width:60%;\">&#160;<img alt=\"个性一星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/56px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/84px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/112px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>生命值提高<font color=\"#58cb48\">4%</font>。战斗开始时获得<font color=\"#ed7950\">2</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"解放\" class=\"bili-tt\"><font color=\"#f3c156\">解放</font></span></span>]。<br />✦受到伤害时，获得<font color=\"#ed7950\">3</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"解放\" class=\"bili-tt\"><font color=\"#f3c156\">解放</font></span></span>]，每回合最多触发1次。<br />✦若自身或目标处于[<span style=\"display:inline;white-space:nowrap;\">土地</span>]、[<span style=\"display:inline;white-space:nowrap;\">沙地</span>]、[<span style=\"display:inline;white-space:nowrap;\">荒地</span>]、[<span style=\"display:inline;white-space:nowrap;\">流沙</span>]或[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"沙尘\" class=\"bili-tt\"><font color=\"#f3c156\">沙尘</font></span></span>]中，造成伤害时产生<font color=\"#58cb48\">30%</font>[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"生命汲取\" class=\"bili-tt\"><font color=\"orange\">生命汲取</font></span></span>]。\n</p>\n</td>\n<td class=\"text-nowra