zj/thumb/5/5b/qyomelrh2ws97lh9h9aumhwjq665qdj.png/80px-%E6%8A%80%E8%83%BD_%E5%AF%92%E5%86%B0%E5%BC%BA%E8%A2%AD.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5b/qyomelrh2ws97lh9h9aumhwjq665qdj.png/120px-%E6%8A%80%E8%83%BD_%E5%AF%92%E5%86%B0%E5%BC%BA%E8%A2%AD.png 1.5x, https://patchwiki.biligame.com/images/llzj/5/5b/qyomelrh2ws97lh9h9aumhwjq665qdj.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />寒冰强袭\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>1\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>4\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>2-3十字\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓1-↑1\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3纵居中\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（魔法伤害）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，选择自身十字范围内<font color=\"#ed7950\">1</font>个地点，冲锋至该地点并对沿路所有敌人，造成<font color=\"#ed7950\">100%</font>[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"物理护盾\" class=\"bili-tt\"><font color=\"orange\">物理护盾</font></span></span>]值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰属性\" class=\"bili-tt\"><font color=\"orange\">冰属性</font></span></span>]伤害。自身获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰面作战\" class=\"bili-tt\"><font color=\"blue\">冰面作战</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 2-3十字 3纵居中.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/4/4e/hjj9gsck336oxrx95rp1sqex5w01md5.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_2-3%E5%8D%81%E5%AD%97_3%E7%BA%B5%E5%B1%85%E4%B8%AD.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/4/4e/hjj9gsck336oxrx95rp1sqex5w01md5.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%B8%AD%E6%A2%A6%E5%A8%9C\" title=\"角色图鉴库/席梦娜\"><img alt=\"头像 席梦娜.png\" src=\"https://patchwiki.biligame.com/images/llzj/a/ab/12ow5j22chii4rda6ja3arlxcu5gp4p.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">席梦娜</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=