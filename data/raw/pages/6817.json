zj/thumb/a/ad/6zm7qstoh8zp27wujxj8ehoz2i8txii.png/80px-%E6%8A%80%E8%83%BD_%E5%85%83%E7%B4%A0%E9%A3%8E%E6%9A%B4.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/a/ad/6zm7qstoh8zp27wujxj8ehoz2i8txii.png/120px-%E6%8A%80%E8%83%BD_%E5%85%83%E7%B4%A0%E9%A3%8E%E6%9A%B4.png 1.5x, https://patchwiki.biligame.com/images/llzj/a/ad/6zm7qstoh8zp27wujxj8ehoz2i8txii.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />元素风暴\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-5\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓5-↑3\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（魔法伤害）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"魔法强化\" class=\"bili-tt\"><font color=\"#54b4db\">魔法强化</font></span></span>]，对目标范围<font color=\"#ed7950\">3</font>格内所有敌人造成<font color=\"#d68fe2\">180%</font>伤害，每额外命中1名目标，伤害倍率降低<font color=\"#ed7950\">15%</font>，最低<font color=\"#ed7950\">45%</font>。<br />✦攻击前，攻击提高<font color=\"#ed7950\">15%</font>，暴击率提高<font color=\"#ed7950\">50%</font>，对中心范围<font color=\"#ed7950\">2</font>格目标额外施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"易伤3\" class=\"bili-tt\"><font color=\"orange\">易伤3</font></span></span>]，持续2回合；<br />✦攻击后，对技能范围内目标施加<font color=\"#ed7950\">1</font>次[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"点燃\" class=\"bili-tt\"><font color=\"orange\">点燃</font></span></span>]，并使地形变为[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰冻\" class=\"bili-tt\"><font color=\"orange\">冰冻</font></span></span>]，持续2回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-5 3.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/7/7d/9d6tdon38aaqpdxdifhy9x2qbdntq4k.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-5_3.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"79\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/7/7d/9d6tdon38aaqpdxdifhy9x2qbdntq4k.png/120px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-5_3.png 1.5x, https://patchwiki.biligame.com/images/llzj/7/7d/9d6tdon38aaqpdxdifhy9x2qbdntq4k.png 2x\" data-file-width=\"127\" data-file-height=\"126\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left; width:80px;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"skill_icon_box\">\n<div data-type=\"@悬浮框/技能2\" data-name=\"元素掌控\" class=\"bili-tt skil