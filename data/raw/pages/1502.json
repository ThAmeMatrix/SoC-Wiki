/llzj/b/b5/4cyaxvme10nbxvb0dprbjkm2p12efho.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%85%89%E8%BE%89%E6%9C%AF%E5%B8%88%E2%80%9C%E5%9C%A3%E7%9C%B7%E2%80%9D\" title=\"角色图鉴库/光辉术师“圣眷”\"><img alt=\"头像 光辉术师“圣眷”.png\" src=\"https://patchwiki.biligame.com/images/llzj/4/4a/7btr97jt963hrfixyvbsvdhzh7u9n5l.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">光辉术师“圣眷”</font></div>\n</div><div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E4%BC%8A%E5%8D%97%E5%A8%9C\" title=\"角色图鉴库/伊南娜\"><img alt=\"头像 伊南娜.png\" src=\"https://patchwiki.biligame.com/images/llzj/b/b5/9hm20wqmn7ph2gcqx5l6cy0zgizkd3m.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">伊南娜</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%A1%94%E5%9F%83%E5%B0%94\" title=\"角