zj/thumb/b/b4/egbsgdf84se1ujz75ghsiulmc11nxz6.png/80px-%E6%8A%80%E8%83%BD_%E6%BC%AB%E5%A4%A9%E7%AE%AD%E7%BD%91.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/b/b4/egbsgdf84se1ujz75ghsiulmc11nxz6.png/120px-%E6%8A%80%E8%83%BD_%E6%BC%AB%E5%A4%A9%E7%AE%AD%E7%BD%91.png 1.5x, https://patchwiki.biligame.com/images/llzj/b/b4/egbsgdf84se1ujz75ghsiulmc11nxz6.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />漫天箭网\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>2-5\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓8-↑6\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>5\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓8-↑6\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）对目标范围<font color=\"#ed7950\">5</font>格内随机敌人，进行<font color=\"#ed7950\">5</font>次攻击，每次造成<font color=\"#ed7950\">45%</font>伤害。并对目标施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"狩猎对象\" class=\"bili-tt\"><font color=\"#54b4db\">狩猎对象</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 2-5 5.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/1/1b/60rtywkckrsgmr7y65rqqtb73u258jq.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_2-5_5.png.jpeg\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"82\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/1/1b/60rtywkckrsgmr7y65rqqtb73u258jq.png/120px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_2-5_5.png.jpeg 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/1/1b/60rtywkckrsgmr7y65rqqtb73u258jq.png/160px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_2-5_5.png.jpeg 2x\" data-file-width=\"197\" data-file-height=\"202\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_box\">\n<div class=\"hero_img\"><a href=\"/llzj/%E9%AD%94%E7%89%A9%E5%9B%BE%E9%89%B4%E5%BA%93/%E9%87%91%E7%8B%AE%E5%B0%84%E6%89%8B\" title=\"魔物图鉴库/金狮射手\"><img alt=\"金狮射手 像素模型.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/0/03/poev90bwd6hblwljrs15ofjh2qo4nh4.png/75px-%E9%87%91%E7%8B%AE%E5%B0%84%E6%89%8B_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" decoding=\"async\" loading=\"lazy\" width=\"75\" height=\"75\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/0/03/poev90bwd6hblwljrs15ofjh2qo4nh4.png/113px-%E9%87%91%E7%8B%AE%E5%B0%84%E6%89%8B_%E5%83%8F%E7%B4%A0%E6