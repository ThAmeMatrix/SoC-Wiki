zj/thumb/5/52/hi08pd90g4hiewvlf10s1xpvijlt4ft.png/80px-%E6%8A%80%E8%83%BD_%E5%A8%81%E6%85%91%E6%88%98%E6%9C%AF.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/52/hi08pd90g4hiewvlf10s1xpvijlt4ft.png/120px-%E6%8A%80%E8%83%BD_%E5%A8%81%E6%85%91%E6%88%98%E6%9C%AF.png 1.5x, https://patchwiki.biligame.com/images/llzj/5/52/hi08pd90g4hiewvlf10s1xpvijlt4ft.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />威慑战术\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓5-↑3\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>1圈\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，选择地形格，对目标范围<font color=\"#ed7950\">1</font>圈内所有敌人造成<font color=\"#ed7950\">30%</font>伤害，驱散<font color=\"#ed7950\">2</font>个[<span style=\"display:inline;white-space:nowrap;\">增益</span>]，施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"致盲\" class=\"bili-tt\"><font color=\"#f3c156\">致盲</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"目眩\" class=\"bili-tt\"><font color=\"#f3c156\">目眩</font></span></span>]及[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▼攻击2\" class=\"bili-tt\"><font color=\"orange\">▼攻击2</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合，并施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"重点标记\" class=\"bili-tt\"><font color=\"#54b4db\">重点标记</font></span></span>]。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-3 1圈.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/fqdgppb0d4105h1tmiqwd26o09ippa8.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-3_1%E5%9C%88.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/2/23/fqdgppb0d4105h1tmiqwd26o09ippa8.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%A7%91%E5%B0%94%E2%80%A2%E7%A0%B4%E6%99%93%E4%B9%8B%E5%BD%B1\" title=\"角色图鉴库/科尔•破晓之影\"><img alt=\"头像 科尔•破晓之影.png\" src=\"https://patchwiki.biligame.com/images/llzj/3/37/s64mud9bi15h38c9dwqxym1is3qfo2p.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">科尔•破晓之影</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"displa