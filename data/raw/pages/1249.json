-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E6%AD%8C%E6%B4%9B%E8%8E%89%E4%BA%9A\" title=\"角色图鉴库/歌洛莉亚\"><img alt=\"头像 歌洛莉亚.png\" src=\"https://patchwiki.biligame.com/images/llzj/7/70/4l82woi612uwz8xhj71bfxuxj1ij2hv.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">歌洛莉亚</font></div>\n</div><div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%BF%A0%E6%96%AF%E5%9D%A6\" title=\"角色图鉴库/翠斯坦\"><img alt=\"头像 翠斯坦.png\" src=\"https://patchwiki.biligame.com/images/llzj/f/f8/qxmiscgs2hzov40skvj0pwby5pcs8hf.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">翠斯坦</font></div>\n</div></div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20261022163544\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.440 seconds\nReal time usage: 0.613 seconds\nPreprocessor visited node count: 9572/1000000\nPost‐expand include size: 166545/2097152 bytes\nTemplate 