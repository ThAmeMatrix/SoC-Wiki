zj/thumb/4/49/crxslmoxyh3v1wbbsbd29u50mrz3sww.png/80px-%E6%8A%80%E8%83%BD_%E8%9B%AE%E7%86%8A%E4%B9%8B%E5%8A%9B.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/4/49/crxslmoxyh3v1wbbsbd29u50mrz3sww.png/120px-%E6%8A%80%E8%83%BD_%E8%9B%AE%E7%86%8A%E4%B9%8B%E5%8A%9B.png 1.5x, https://patchwiki.biligame.com/images/llzj/4/49/crxslmoxyh3v1wbbsbd29u50mrz3sww.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />蛮熊之力\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓5-↑3\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，跳跃至目标地点，并对目标范围<font color=\"#ed7950\">3</font>格内所有敌人（不含[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"物品\" class=\"bili-tt\"><font color=\"#f3c156\">物品</font></span></span>]）造成<font color=\"#ed7950\">100%</font>[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰属性\" class=\"bili-tt\"><font color=\"orange\">冰属性</font></span></span>][<span style=\"display:inline;white-space:nowrap;\">范围伤害</span>]。<br />✦[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"血脉沸腾\" class=\"bili-tt\"><font color=\"#54b4db\">血脉沸腾</font></span></span>]未耗尽时，本技能所消耗能量减少<font color=\"#ed7950\">2</font>，且进行追击，对范围内敌人造成<font color=\"#ed7950\">50%</font>[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰属性\" class=\"bili-tt\"><font color=\"orange\">冰属性</font></span></span>][<span style=\"display:inline;white-space:nowrap;\">范围伤害</span>]，并进入[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"蛮熊形态\" class=\"bili-tt\"><font color=\"#54b4db\">蛮熊形态</font></span></span>]。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-3 3.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/88/gna3oc2cjl54ui7uiti4hvjxnhrilam.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-3_3.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/8/88/gna3oc2cjl54ui7uiti4hvjxnhrilam.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E9%98%BF%E5%88%97%E5%85%8B%E8%B0%A2%E2%80%A2%E9%A3%8E%E9%9B%AA%E5%AD%A4%E8%A1%8C\" title=\"角色图鉴库/阿列克谢•风雪孤行\"><img alt=\"头像 阿列克谢•风雪孤行.png\" src=\"https://patchwiki.biligame.com/images/llzj/e/e7/p3uev98o9wqyvt0sj9v59pw1twf9swg.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data