3.png/80px-%E6%8A%80%E8%83%BD_%E8%83%8C%E5%88%BA.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/8/8b/dke1bj8d8sb0i4nzn1ymclgah6ndbo3.png/120px-%E6%8A%80%E8%83%BD_%E8%83%8C%E5%88%BA.png 1.5x, https://patchwiki.biligame.com/images/llzj/8/8b/dke1bj8d8sb0i4nzn1ymclgah6ndbo3.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />倒吊人的清算\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:10%;\"><center><b>&#160;技能类别<br /></b>[职业技能]</center>\n</td>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\">&#160;\n<p>（被动）攻击后，若目标处于[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"濒死\" class=\"bili-tt\"><font color=\"orange\">濒死</font></span></span>]状态且有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"倒吊人标记\" class=\"bili-tt\"><font color=\"orange\">倒吊人标记</font></span></span>]时，额外对目标造成<font color=\"red\">30%</font>生命值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"穿透伤害\" class=\"bili-tt\"><font color=\"orange\">穿透伤害</font></span></span>]。造成伤害后，移除标记。\n</p>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div>\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%80%92%E5%90%8A%E4%BA%BA%E2%80%9C%E6%89%A7%E5%89%91%E8%80%85%E2%80%9D\" title=\"角色图鉴库/倒吊人“执剑者”\"><img alt=\"头像 倒吊人“执剑者”.png\" src=\"https://patchwiki.biligame.com/images/llzj/b/bd/glnd0m76utceljaoyuj7re6c8e1vnbd.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"wi