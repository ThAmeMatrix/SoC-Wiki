 width=\"65\" height=\"65\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/7/7b/bdxsswq2neqstneo43aobr0kisd0zoh.png/98px-%E6%8A%80%E8%83%BD%E8%83%8C%E6%99%AF_%E5%8F%B2%E8%AF%97.png 1.5x, https://patchwiki.biligame.com/images/llzj/7/7b/bdxsswq2neqstneo43aobr0kisd0zoh.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></div>\n    <div data-type=\"@悬浮框/极限解放\" data-name=\"机动援协之道\" class=\"bili-tt gx_img\"><a href=\"/llzj/%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE/%E6%9C%BA%E5%8A%A8%E6%8F%B4%E5%8D%8F%E4%B9%8B%E9%81%93\" title=\"极限解放/机动援协之道\"><img alt=\"极限解放 机动援协之道.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/7/78/t2e1i2yoofxsj738344h3l8gu821ou8.png/65px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E6%9C%BA%E5%8A%A8%E6%8F%B4%E5%8D%8F%E4%B9%8B%E9%81%93.png\" decoding=\"async\" loading=\"lazy\" width=\"65\" height=\"65\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/7/78/t2e1i2yoofxsj738344h3l8gu821ou8.png/98px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E6%9C%BA%E5%8A%A8%E6%8F%B4%E5%8D%8F%E4%B9%8B%E9%81%93.png 1.5x, https://patchwiki.biligame.com/images/llzj/7/78/t2e1i2yoofxsj738344h3l8gu821ou8.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></div>\n    <div class=\"gx_name\"><a href=\"/llzj/%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE/%E6%9C%BA%E5%8A%A8%E6%8F%B4%E5%8D%8F%E4%B9%8B%E9%81%93\" title=\"极限解放/机动援协之道\"><font color=\"#FFF\">机动援协之道</font></a></div>\n    </div>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:15%;\">关联内容\n</th>\n<td style=\"text-align:left\">\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">角色绰号\n</th>\n<td>暂无\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配置推荐\n</th>\n<td>同下\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色攻略\n</th>\n<td>【by爱玩游戏的吐鲁番】<a rel=\"nofollow\" class=\"external free\" href=\"https://m.bilibili.com/video/BV1b8zPBdEZ4\">https://m.bilibili.com/video/BV1b8zPBdEZ4</a>\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">中文CV\n</th>\n<td>宋政楠\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">日文CV\n</th>\n<td>园崎未惠\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配音展示\n</th>\n<td>【ThAmeReborn】<a rel=\"nofollow\" class=\"external free\" href=\"https://www.bilibili.com/video/BV1FgzKBEE48\">https://www.bilibili.com/video/BV1FgzKBEE48</a>\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色生平\n</th>\n<td>独立于帝国统治外的神秘组织“弃亡者”的首领。安娜是出生于纯血者家族的不洁者，因目睹了一名凡血者与伊凡大帝的决斗而受到感召，决意为保护低血统者、改变血统制度而战，九死一生后成为“弃亡者”的首领。<br />\n<p>她带领被遗忘的人们蛰伏于冰原的阴影之下，缓慢渗透帝国，传播思想，吸纳力量，也因此被帝国人视为敌人、叛徒，生存境遇愈发艰难.....随着北寻的再一次开启，围绕着血统制度的谎言、阴谋逐一浮出水面。在贫瘠残酷的冰原之上，似乎只有牺牲一部分人，才能让大多数人活下去。当所有人都以大局为名义，默许着牺牲的发生，安娜却选择燃烧自己，哪怕只发出微渺的光亮\n</p>\n</td></tr></tbody></table> \n<table class=\"wikitable\" style=\"width: 100%;\">\n<tbody><tr>\n<th>原皮肤像素模型</th>\n<th>皮肤像素模型\n</th></tr>\n<tr>\n<td style=\"text-align: center; width: 50%;\"><a href=\"/llzj/%E6%96%87%E4%BB%B6:%E5%AE%89%E5%A8%9C_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" class=\"image\"><img alt=\"安娜 像素模型.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/28/9qv3brt1zz215e8wjjg4a5v7xnshjgd.png/100px-%E5%AE%89%E5%A8%9C_%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"100\" srcset=\"https://patchwiki.biligame.com/images/llzj/2/28/9qv3brt1zz215e8wjjg4a5v7xnshjgd.png 1.5x\" data-file-width=\"128\" data-file-height=\"128\" /></a></td>\n<td style=\"text-align: center; width: 50%;\"><a href=\"/llzj/%E6%96%87%E4%BB%B6:%E5%AE%89%E5%A8%9C_%E7%9A%AE%E8%82%A4%E5%83%8F%E7%B4%A0%E6%A8%A1%E5%9E%8B.png\" class=\"image\"><img alt=\"安娜 皮肤像素模型.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/1/17/9kyzekhdwtsie8s2g3xe8nxrti92fp2.png/100px-%E5%AE%89%E5%A