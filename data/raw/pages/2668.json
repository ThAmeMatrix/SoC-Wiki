8C%E8%A2%8D%E7%9A%84%E9%BC%93%E8%88%9E.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/53/tlx2k2s6xqvztf63zwnu7ssxnv4nv6z.png/120px-%E6%8A%80%E8%83%BD_%E5%90%8C%E8%A2%8D%E7%9A%84%E9%BC%93%E8%88%9E.png 1.5x, https://patchwiki.biligame.com/images/llzj/5/53/tlx2k2s6xqvztf63zwnu7ssxnv4nv6z.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />同袍的鼓舞\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:10%;\"><center><b>&#160;技能类别<br /></b>[职业技能]</center>\n</td>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\">&#160;\n<p>（被动）行动开始时，若自身范围<font color=\"red\">2</font>格内有<font color=\"red\">2</font>个及以上友军，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲伤害2\" class=\"bili-tt\"><font color=\"orange\">▲伤害2</font></span></span>]，持续<font color=\"red\">1</font>回合。被主动攻击时，若自身范围<font color=\"red\">2</font>格内有<font color=\"red\">2</font>个及以上友军，受到伤害降低<font color=\"red\">20%</font>。\n</p>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div>\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%8E%8B%E5%9B%BD%E5%86%9B%E7%81%AB%E6%9C%AF%E5%A3%AB\" title=\"角色图鉴库/王国军火术士\"><img alt=\"头像 王国军火术士.png\" src=\"https://patchwiki.biligame.com/images/llzj/0/0a/6jvb3e17pl5pv6bwcr009nkt5x6a034.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">王国军火术士</font></div>\n</div><div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%