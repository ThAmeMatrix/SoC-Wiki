snm\" style=\"color: #a94442; border: 1px solid #5cb85c; padding: 5px; margin-bottom: 20px; border-radius: 4px;\">\n<ul><li>资源统计表主要记录每月获取的希望晶石、星铸残胚、领悟之力。</li></ul>\n</div>\n<table class=\"wikitable\" style=\"width:100%;max-width: 800px; margin:auto; text-align:center; table-layout:fixed; word-break:break-all; background:#fffaf5; border:1px solid #ffccbc; border-radius:8px; white-space:normal;\">\n<caption><div style=\"margin-top: 10px; margin-bottom: 10px; text-align: center; visibility: visible;\">\n<div style=\"display: inline-block; vertical-align: middle; width: 10px; visibility: visible;\">\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div></div>\n<div style=\"display: inline-block; vertical-align: middle; padding-left: 6px; padding-right: 6px; font-size: 17px; visibility: visible;\"><p style=\"visibility: visible;\"><strong style=\"visibility: visible;\">铃兰之剑资源统计2026/03</strong></p></div>\n<div style=\"display: inline-block; vertical-align: middle; width: 10px; visibility: visible;\">\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; margin-left: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div>\n<div style=\"width: 5px; height: 5px; background-color: rgb(218, 203, 158); visibility: visible;\"></div></div></div>\n</caption>\n<tbody><tr>\n<th style=\"width:14%\">项目\n</th>\n<th style=\"width:12%\">希望晶石\n</th>\n<th style=\"width:9%\">秘缘\n</th>\n<th style=\"width:8%\">领悟之力\n</th>\n<th style=\"width:11%\">星铸残胚\n</th>\n<th style=\"width:16%\">晶石算法\n</th>\n<th style=\"width:30%\">备注\n</th></tr>\n<tr>\n<td>签到</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>4*100</td>\n<td>\n</td></tr>\n<tr>\n<td>日常任务</td>\n<td>1860</td>\n<td></td>\n<td></td>\n<td></td>\n<td>31*60</td>\n<td>\n</td></tr>\n<tr>\n<td>频道活跃</td>\n<td>500</td>\n<td></td>\n<td></td>\n<td></td>\n<td>5*100</td>\n<td>5次周一\n</td></tr>\n<tr>\n<td>大月卡(免费)</td>\n<td>250</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>荣耀之战</td>\n<td>605</td>\n<td></td>\n<td>1</td>\n<td></td>\n<td>5*31+150+300</td>\n<td>日常奖励、活跃奖励、排名奖励\n</td></tr>\n<tr>\n<td>征服之塔</td>\n<td>1900</td>\n<td></td>\n<td></td>\n<td></td>\n<td>5*380</td>\n<td>5次周一\n</td></tr>\n<tr>\n<td>维护更新</td>\n<td>550</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*150+50+150+50</td>\n<td>2次周四更新150钻<br />3月12日闪断50钻<br />3月19日修复补偿<br />3月26日闪断50钻\n</td></tr>\n<tr>\n<td>角色试用</td>\n<td>300</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*150</td>\n<td>乌莉娅150钻<br />伊凡150钻\n</td></tr>\n<tr>\n<td>人气投票</td>\n<td>400</td>\n<td></td>\n<td></td>\n<td></td>\n<td>2*200</td>\n<td>第二、三阶段\n</td></tr>\n<tr>\n<td>凛风回廊</td>\n<td>1410</td>\n<td>3</td>\n<td>1</td>\n<td></td>\n<td>1210+40*5</td>\n<td>任务+5次刷新奖励\n</td></tr>\n<tr>\n<td>兑换码</td>\n<td>300</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>hyppgwpy496ss\n</td></tr>\n<tr>\n<td>贝拉皮肤复刻</td>\n<td>150</td>\n<td></td>\n<td></td>\n<td></td>\n<td>3*50</td>\n<td>\n</td></tr>\n<tr>\n<td>共揽星碑</td>\n<td>900</td>\n<td></td>\n<td></td>\n<td>200</td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>妙想许愿机</td>\n<td></td>\n<td>5</td>\n<td></td>\n<td>200</td>\n<td></td>\n<td>\n</td></tr>\n<tr>\n<td>“赤子”皮肤</td>\n<td>350</td>\n<td></td>\n<td></td>\n<td></td>\n<td>50*7</td>\n<td>免费档\n</td></tr>\n<tr>\n<td>冰原之心(门内)</td>\n<td>2555</td>\n<td></td>\n<td></td>\n<td></td>\n<td>27*40+6*80+27*25+8*40</td>\n<td>剧情主线关卡<br />任务成就奖励<br />演出留念奖励<br />女神试炼1-8\n</td></tr>\n<tr style=\"background: #eee6dd;\">\n<td><b>总计</b></td>\n<td>12430</td>\n<td>8</td>\n<td>2</td>\n<td>400</td>\n<td></td>\n<td>26年3月共90.8抽\n</td></tr>\n<tr style=\"background: #eaecf0;\">\n<td colspan=\"7\"><b>其他项目</b