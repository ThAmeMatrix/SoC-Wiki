n>25</option><option>26</option><option>27</option><option>28</option><option>29</option><option>30</option><option>31</option><option>32</option>\n<option>33</option><option>34</option><option>35</option><option>36</option><option>37</option><option>38</option><option>39</option><option>40</option><option>41</option><option>42</option><option>43</option><option>44</option><option>45</option><option>46</option><option>47</option><option>48</option>\n<option>49</option><option>50</option><option>51</option><option>52</option><option>53</option><option>54</option><option>55</option><option>56</option>\n<option>57</option><option>58</option><option>59</option><option>60</option>\n</select>\n</div>\n<div style=\"height:35px; width:48%; display:inline\">\n<span style=\"font-weight: bold\">星级:</span>\n<select id=\"equipement_star\" style=\"width: 50px; height: 28px\" onmousedown=\"selectmousedown(this)\" onblur=\"selectblur(this)\" onchange=\"selectchange(this)\" data-bind=\"value: 星级\">\n<option>1</option><option>2</option><option>3</option><option>4</option><option>5</option>\n</select>\n</div>\n</div>\n\n<div>&nbsp;</div>\n\n<div style=\"display:flex; justify-content:space-around\">\n<div style=\"height:35px; width:48%; display:flex; justify-content:flex-start; align-items:center\">\n<div style=\"background-color:rgb(118 103 79); width:28px; height:28px; display:flex; justify-content:center\">\n<img src=\"https://patchwiki.biligame.com/images/llzj/4/44/55wa9v348kdpv7nsqscoku7cs4qcc23.png\">\n</div>\n&nbsp;物攻&nbsp;<span data-bind=\"text: 物攻\"></span>\n</div>\n<div style=\"height:35px; width:48%; display:flex; justify-content:flex-start; align-items:center\">\n<div style=\"background-color:rgb(118 103 79); width:28px; height:28px; display:flex; justify-content:center\">\n<img src=\"https://patchwiki.biligame.com/images/llzj/7/79/j0f8bpd8k9b3uahxaytk3xttkskvz7r.png\">\n</div>\n&nbsp;魔攻&nbsp;<span data-bind=\"text: 魔攻\"></span>\n</div>\n</div>\n\n<div>&nbsp;</div>\n\n<div style=\"display:flex; justify-content:space-around\">\n<div style=\"height:35px; width:48%; display:flex; justify-content:flex-start; align-items:center\">\n<div style=\"background-color:rgb(118 103 79); width:28px; height:28px; display:flex; justify-content:center\">\n<img src=\"https://patchwiki.biligame.com/images/llzj/8/86/a28jupdnch4m4ux4kcygr3sww8fmi9l.png\">\n</div>\n&nbsp;物防&nbsp;<span data-bind=\"text: 物防\"></span>\n</div>\n<div style=\"height:35px; width:48%; display:flex; justify-content:flex-start; align-items:center\">\n<div style=\"background-color:rgb(118 103 79); width:28px; height:28px; display:flex; justify-content:center\">\n<img src=\"https://patchwiki.biligame.com/images/llzj/9/9e/nx1g7z11c67ttcj9zkhysaajpbjsqbg.png\">\n</div>\n&nbsp;魔防&nbsp;<span data-bind=\"text: 魔防\"></span>\n</div>\n</div>\n\n<div>&nbsp;</div>\n\n<div style=\"display:flex; justify-content:space-around\">\n<div style=\"height:35px; width:48%; display:flex; justify-content:flex-start; align-items:center\">\n<div style=\"background-color:rgb(118 103 79); width:28px; height:28px; display:flex; justify-content:center\">\n<img src=\"https://patchwiki.biligame.com/images/llzj/6/61/3wiqk8zykmdnzzxx8tyoj9lualhyggu.png\">\n</div>\n&nbsp;生命&nbsp;<span data-bind=\"text: 生命\"></span>\n</div>\n<div style=\"height:35px; width:48%; display:flex; justify-content:flex-start; align-items:center\">\n<div style=\"width:28px; height:28px; display:flex; justify-content:center\">\n</div>\n</div>\n</div>\n\n</body>\n\n<script src=\"https://wiki.biligame.com/ys/MediaWiki:Knockout.js?action=raw&ctype=text/javascript\"></script>\n<script>\ndata_table={\nsword_sr:[26,0,12,6,70,4.44,0,1.62,1.12,11,8.4,0,3,2,21.9]\n};\n\nfunction selectmousedown(ev) {\n  if (ev.options.length > 5) {\n    ev.size = 6;\n    $(ev).css({\n      \"height\": \"auto\",\n      \"position\": \"absolute\"\n    })\n  } else {\n    $(ev).css(\"height\", \"28px\")\n  }\n}\n\nfunction selectblur(ev) {\n  ev.size = 0;\n  $(ev).css({\n    \"height\": \"28px\",\n    \"width\": \"50px\",\n    \"position\": \"static\"\n  })\n}\n\nfunction selectchange(ev) {\n  ev.size = 0;\n  $(ev).css({\n    \"height\": \"28px\",\n    \"width\": \"50px\",\n    \"position\": \"static\"\n  })\n}\n\nfunction viewModel() {\n    var self = this;\n    self.等级 = ko.observable();\n    self.星级 = ko.observable();\n    self.分类 = document.getElementById(\"PNN\").innerHTML;\n    self.data = data_table[self.分类]\n    \n    <!-- self.物攻 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[5] + self.data[0] + (Number(self.星级())-1)*self.data[10]);\n  }); \n    self.魔攻 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[6] + self.data[1] + (Number(self.星级())-1)*self.data[11]);\n  }); \n    self.物防 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[7] + self.data[2] + (Number(self.星级())-1)*self.data[12]);\n  }); \n    self.魔防 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[8] + self.data[3] + (Number(self.星级())-1)*self.data[13]);\n  }); \n    self.生命 = ko.computed(function() {\n    return parseInt((Number(self.等级())-1)*self.data[9] + self.data[4] + (Number(self.星级())-1)*self.data[14]);\n  }); --> \n}\n\nko.applyBindings(new viewModel());\n</script>\n</td></tr>\n<tr>\n<td>来源：邂逅星铸神兵池、装备商店兑换星铸神兵、丰饶商店兑换星铸定影\n</td>\n<td>*<small>特别声明：目前计算公式还在推算中，个别数值会与真实值存在差别。</small>\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%; background:none\">\n<tbody><tr>\n<td rowspan=\"5;\" width=\"10%\"><center><b>装<br />备<br />技<br />能</b><br /><br /></center>\n</td>\n<td><img alt=\"天赋一星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/1/10/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/70px-%E5%A4%A9%E8%B5%8B%E4%B8%80%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"18\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/1/10/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/105px-%E5%A4%A9%E8%B5%8B%E4%B8%80%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/1/10/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/140px-%E5%A4%A9%E8%B5%8B%E4%B8%80%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />\n<p>✦释放普攻和无能量消耗的职业技能前，获得<font color=\"#ed7950\">1</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"缄默铁誓1\" class=\"bili-tt\"><font color=\"#54b4db\">缄默铁誓1</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。<br />✦拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"免疫干扰\" class=\"bili-tt\"><font color=\"orange\">免疫干扰</font></span></span>]，攻防属性提高<font color=\"#ed7950\">2%</font>。<br />✦场上存在任意[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"戒律\" class=\"bili-tt\"><font color=\"#f3c156\">戒律</font></span></span>]时，攻防属性额外提高<font color=\"#ed7950\">2%</font>。\n<br /><br />\n</p>\n</td></tr>\n<tr>\n<td><img alt=\"天赋二星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/70px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"18\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/105px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/140px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />\n<p>✦释放普攻和无能量消耗的职业技能前，获得<font color=\"#ed7950\">1</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"缄默铁誓2\" class=\"bili-tt\"><font color=\"#54b4db\">缄默铁誓2</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。<br />✦拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"免疫干扰\" class=\"bili-tt\"><font color=\"orange\">免疫干扰</font></span></span>]，攻防属性提高<font color=\"#ed7950\">4%</font>。<br />✦场上存在任意[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"戒律\" class=\"bili-tt\"><font color=\"#f3c156\">戒律</font></span></span>]时，攻防属性额外提高<font color=\"#ed7950\">4%</font>。\n<br /><br />\n</p>\n</td></tr>\n<tr>\n<td><img alt=\"天赋三星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/70px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"18\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/105px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/140px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />\n<p>✦释放普攻和无能量消耗的职业技能前，获得<font color=\"#ed7950\">2</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"缄默铁誓2\" class=\"bili-tt\"><font color=\"#54b4db\">缄默铁誓2</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。<br />✦拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"免疫干扰\" class=\"bili-tt\"><font color=\"orange\">免疫干扰</font></span></span>]，攻防属性提高<font color=\"#ed7950\">6%</font>。<br />✦场上存在任意[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"戒律\" class=\"bili-tt\"><font color=\"#f3c156\">戒律</font></span></span>]时，攻防属性额外提高<font color=\"#ed7950\">6%</font>。\n<br /><br />\n</p>\n</td></tr>\n<tr>\n<td><img alt=\"天赋四星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/70px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"18\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d