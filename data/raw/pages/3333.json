e0/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/56px-%E4%B8%AA%E6%80%A7%E4%BA%8C%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e0/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/84px-%E4%B8%AA%E6%80%A7%E4%BA%8C%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/e/e0/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/112px-%E4%B8%AA%E6%80%A7%E4%BA%8C%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>攻防属性提高<font color=\"red\">10%</font>。行动开始时，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰铠\" class=\"bili-tt\"><font color=\"blue\">冰铠</font></span></span>]，冷却<font color=\"red\">2</font>回合。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"个性三星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/0/07/czx3heixk04558ia8wj7hpokhzl5cbx.png/56px-%E4%B8%AA%E6%80%A7%E4%B8%89%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/0/07/czx3heixk04558ia8wj7hpokhzl5cbx.png/84px-%E4%B8%AA%E6%80%A7%E4%B8%89%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/0/07/czx3heixk04558ia8wj7hpokhzl5cbx.png/112px-%E4%B8%AA%E6%80%A7%E4%B8%89%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>攻防属性提高<font color=\"red\">10%</font>。行动开始时，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰铠\" class=\"bili-tt\"><font color=\"blue\">冰铠</font></span></span>]。被攻击后若处于[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"濒死\" class=\"bili-tt\"><font color=\"orange\">濒死</font></span></span>]状态，立刻获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰铠\" class=\"bili-tt\"><font color=\"blue\">冰铠</font></span></span>]，每场战斗最多发动<font color=\"red\">1</font>次。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"个性四星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/1/10/eer5d47lht2ycljkd8fe3yu05q10ccr.png/56px-%E4%B8%AA%E6%80%A7%E5%9B%9B%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/1/10/eer5d47lht2ycljkd8fe3yu05q10ccr.png/84px-%E4%B8%AA%E6%80%A7%E5%9B%9B%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/1/10/eer5d47lht2ycljkd8fe3yu05q10ccr.png/112px-%E4%B8%AA%E6%80%A7%E5%9B%9B%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>攻防属性提高<font color=\"red\">15%</font>。行动开始时，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰铠\" class=\"bili-tt\"><font color=\"blue\">冰铠</font></span></span>]。被攻击后若处于[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"濒死\" class=\"bili-tt\"><font color=\"orange\">濒死</font></span></span>]状态，立刻获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰铠\" class=\"bili-tt\"><font color=\"blue\">冰铠</font></span></span>]，每场战斗最多发动<font color=\"red\">1</font>次。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"个性五星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/20/l6fgusj2lxp7caktkwbmf1ioo2m7utz.png/56px-%E4%B8%AA%E6%80%A7%E4%BA%94%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/2/20/l6fgusj2lxp7caktkwbmf1ioo2m7utz.png/84px-%E4%B8%AA%E6%80%A7%E4%BA%94%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/2/20/l6fgusj2lxp7caktkwbmf1ioo2m7utz.png/112px-%E4%B8%AA%E6%80%A7%E4%BA%94%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>攻防属性提高<font color=\"red\">15%</font>。自身拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-ty