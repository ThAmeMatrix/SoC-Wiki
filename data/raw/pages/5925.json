A%E6%80%A7_%E6%8D%95%E6%A2%A6.png 1.5x, https://patchwiki.biligame.com/images/llzj/9/9d/gvw89ucv24dr986uv4isx4dqw811ek4.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />雪鹿\n</th>\n<td class=\"wiki-bot text-left\" style=\"width:60%;\">&#160;<img alt=\"个性一星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/56px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/84px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/112px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>不可移动，受到伤害降低<font color=\"red\">30%</font>，下<font color=\"red\">2</font>次行动开始时变回[<span style=\"display:inline;white-space:nowrap;\">阿芙拉</span>]状态。行动结束时，治疗自身范围<font color=\"red\">3</font>格内所有友军，治疗量为魔攻值的<font color=\"red\">60%</font>。<br />\n</p>\n<pre>   &#160;&#160;魔攻、治疗效果提高<font color=\"red\">6%</font>，免疫[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰冻\" class=\"bili-tt\"><font color=\"orange\">冰冻</font></span></span>]地形效果。行动结束时，对自身范围<font color=\"red\">3</font>格内所有敌人施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"梦魇\" class=\"bili-tt\"><font color=\"DeepSkyBlue\">梦魇</font></span></span>] ，若目标已有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"梦魇\" class=\"bili-tt\"><font color=\"DeepSkyBlue\">梦魇</font></span></span>] ，则额外施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"迷梦回廊1\" class=\"bili-tt\"><font color=\"DeepSkyBlue\">迷梦回廊1</font></span></span>] ，所有效果持续<font color=\"red\">2</font>回合。\n</pre>\n</td>\n<td class=\"text-nowrap\" style=\"width:20%;\