zj/thumb/2/22/podpfwr5cvuut9050mh0cpyox4dkvzb.png/80px-%E6%8A%80%E8%83%BD_%E5%BF%AB%E9%80%9F%E6%8E%A9%E6%8A%A4.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/2/22/podpfwr5cvuut9050mh0cpyox4dkvzb.png/120px-%E6%8A%80%E8%83%BD_%E5%BF%AB%E9%80%9F%E6%8E%A9%E6%8A%A4.png 1.5x, https://patchwiki.biligame.com/images/llzj/2/22/podpfwr5cvuut9050mh0cpyox4dkvzb.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />快速掩护\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓8-↑8\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（支援）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，与目标友军换位，使自身与目标获得<font color=\"red\">50%</font>物攻值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"物理护盾\" class=\"bili-tt\"><font color=\"orange\">物理护盾</font></span></span>]，替自身范围<font color=\"red\">1</font>圈内所有友军承受[<span style=\"display:inline;white-space:nowrap;\">物理攻击</span>]，所有效果持续<font color=\"red\">2</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-3 0.pn