zj/thumb/6/66/2fse2dg0dqkq3mgawrogdum5of07bae.png/80px-%E6%8A%80%E8%83%BD_%E8%99%94%E8%AF%9A%E5%AE%88%E5%8D%AB.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/6/66/2fse2dg0dqkq3mgawrogdum5of07bae.png/120px-%E6%8A%80%E8%83%BD_%E8%99%94%E8%AF%9A%E5%AE%88%E5%8D%AB.png 1.5x, https://patchwiki.biligame.com/images/llzj/6/66/2fse2dg0dqkq3mgawrogdum5of07bae.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />虔诚守卫\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（治疗）驱散自身<font color=\"#ed7950\">3</font>个[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"减益\" class=\"bili-tt\"><font color=\"#f3c156\">减益</font></span></span>]，再回复<font color=\"#58cb48\">40%</font>生命值，获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲物防2\" class=\"bili-tt\"><font color=\"orange\">▲物防2</font></span></span>]、[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲魔防2\" class=\"bili-tt\"><font color=\"orange\">▲魔防2</font></span></span>]。替自身范围<font color=\"#ed7950\">2</font>格内所有友军承受攻击，[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"个性\" class=\"bili-tt\"><font color=\"orange\">个性</font></span></span>]效果增强至<font color=\"#ed7950\">200%</font>，持续<font color=\"#ed7950\">2</font>回合，不可驱散，无法免疫。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-0 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/8/84/lekhjouylcdedt30jvnh0upev2fjg1n.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-0_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/8/84/lekhjouylcdedt30jvnh0upev2fjg1n.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%85%89%E8%BE%89%E5%8D%AB%E5%A3%AB%E2%80%9C%E9%AD%94%E7%A6%81%E2%80%9D\" title=\"角色图鉴库/光辉卫士“魔禁”\"><img alt=\"头像 光辉卫士“魔禁”.png\" src=\"https://patchwiki.biligame.com/images/llzj/e/e8/65pwfu123ydc4expdzic9tds90nf2ra.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">光辉卫士“魔禁”</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align