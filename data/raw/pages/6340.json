sswq2neqstneo43aobr0kisd0zoh.png/98px-%E6%8A%80%E8%83%BD%E8%83%8C%E6%99%AF_%E5%8F%B2%E8%AF%97.png 1.5x, https://patchwiki.biligame.com/images/llzj/7/7b/bdxsswq2neqstneo43aobr0kisd0zoh.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></div>\n    <div data-type=\"@悬浮框/极限解放\" data-name=\"陷阵豪壮\" class=\"bili-tt gx_img\"><a href=\"/llzj/%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE/%E9%99%B7%E9%98%B5%E8%B1%AA%E5%A3%AE\" title=\"极限解放/陷阵豪壮\"><img alt=\"极限解放 陷阵豪壮.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/fb/3a3pfjl29rjanmyv05qbjhe36c54hun.png/65px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E9%99%B7%E9%98%B5%E8%B1%AA%E5%A3%AE.png\" decoding=\"async\" loading=\"lazy\" width=\"65\" height=\"65\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/f/fb/3a3pfjl29rjanmyv05qbjhe36c54hun.png/98px-%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE_%E9%99%B7%E9%98%B5%E8%B1%AA%E5%A3%AE.png 1.5x, https://patchwiki.biligame.com/images/llzj/f/fb/3a3pfjl29rjanmyv05qbjhe36c54hun.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /></a></div>\n    <div class=\"gx_name\"><a href=\"/llzj/%E6%9E%81%E9%99%90%E8%A7%A3%E6%94%BE/%E9%99%B7%E9%98%B5%E8%B1%AA%E5%A3%AE\" title=\"极限解放/陷阵豪壮\"><font color=\"#FFF\">陷阵豪壮</font></a></div>\n    </div>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:15%;\">关联内容\n</th>\n<td style=\"text-align:left\">\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">角色绰号\n</th>\n<td>暂无\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配置推荐\n</th>\n<td>同下\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色攻略\n</th>\n<td>【by超能缪缪】<a rel=\"nofollow\" class=\"external free\" href=\"http://game.bilibili.com/linkfilter/?url=https%3A%2F%2Fwww.taptap.cn%2Fmoment%2F712999921954849959\" target=\"_blank\">https://www.taptap.cn/moment/712999921954849959</a>\n</td></tr></tbody></table>\n</div>\n<div class=\"col-xs-12 col-sm-6 col-md-6 col-lg-6\">\n<table class=\"wikitable\" style=\"width:100%;text-align:left\">\n\n<tbody><tr>\n<th style=\"width: 75px;\">中文CV\n</th>\n<td>刘雯\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">日文CV\n</th>\n<td>白石真菜\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">配音展示\n</th>\n<td>【byThAmeReborn】<a rel=\"nofollow\" class=\"external free\" href=\"https://www.bilibili.com/video/BV1Yba4zcEyD\">https://www.bilibili.com/video/BV1Yba4zcEyD</a>\n</td></tr>\n<tr>\n<th style=\"width: 75px;\">角色生平\n</th>\n<td>身着重甲的骑士少女，天性善良乐观、活泼大条。尽管被“满满安全感”的盔甲严密包裹，战场上的她仍难掩胆怯。时刻以“骑士奋勇当先”作为口号自我鼓励，更将圣骑士歌洛莉亚视为崇拜目标，梦想着有朝一日能成为真正保护他人的勇敢骑士。<br />在三国同盟入侵伊利亚之战中，克拉拉响应歌洛莉亚号召，毅然帮助伊利亚抵抗骑士同盟。晨曦堡决战时，为掩护友军撤退，殿后的克拉拉及其队友因寡不敌众战败被俘。后被卖至埃拉曼角斗场，沦为供贵族消遣的奴隶角斗士。<br />角斗场内，残忍血腥的厮杀轮番上演。克拉拉深知自身战力不足，可心中的骑士原则仍驱使她挺身而出，以大盾守护队友。即便胜利希望渺茫，即便双腿因恐惧而颤抖，面对强敌，她仍无数次咬牙向前。每一步勇气的迈进，都让她离心中的骑士精神更近一分。\n</td></tr></tbody></table></div></div></div>\n<!-- \nNewPP limit report\nCached time: 20261022141613\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.268 seconds\nReal time usage: 0.467 seconds\nPreprocessor visited node count: 1753/1000000\nPost‐expand include size: 52785/2097152 bytes\nTemplate argument size: 6196/2097152 bytes\nHighest expansion depth: 13/40\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 399/5000000 bytes\nExtLoops count: 0\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  343.083      1 模板:角色\n100.00%  343.083      1 -total\n 53.72%  184.314      1 模板:技能树\n 44.52%  152.728     14 模板:技能图\n  4.86%   16.687      1 模板:个性图\n  4.56%   15.656      1 模板:极限解放图\n  4.26%   14.621      1 模板:面包屑\n  1.61%    5.508      1 模板:兵种图\n  1.52%    5.218      1 模板:立绘\n  0.92%    3.155      3 模板:阵营图\n-->\n\n<!-- Saved in parser cache with key gamecenter_wiki_llzj-pre_:pcache:idhash:6340-0!dateformat=default and