E%E6%B3%BD.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5e/tpun5jyyugqkwafcbv8yrivnnt080gi.png/120px-%E6%8A%80%E8%83%BD_%E7%A5%9E%E6%B3%BD.png 1.5x, https://patchwiki.biligame.com/images/llzj/5/5e/tpun5jyyugqkwafcbv8yrivnnt080gi.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />神泽\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>1次\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>0-3\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓8-↑8\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>2\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（治疗）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"静聆神谕\" class=\"bili-tt\"><font color=\"#54b4db\">静聆神谕</font></span></span>]，治疗目标范围<font color=\"#ed7950\">2</font>格内所有己方，治疗量为魔攻值的<font color=\"#58cb48\">30%</font>，并使其获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲移动1\" class=\"bili-tt\"><font color=\"orange\">▲移动1</font></span></span>]、免疫[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"×反应技\" class=\"bili-tt\"><font color=\"orange\">×反应技</font></span></span>]及免疫[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"受治疗逆转\" class=\"bili-tt\"><font color=\"orange\">受治疗逆转</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 0-3 2.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/5/58/m0yu83hjajzo2qmw3x6oyzfwherwdrn.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_0-3_2.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/5/58/m0yu83hjajzo2qmw3x6oyzfwherwdrn.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%8F%80%E5%88%97%E7%BB%B4%E7%89%B9\" title=\"角色图鉴库/珀列维特\"><img alt=\"头像 珀列维特.png\" src=\"https://patchwiki.biligame.com/images/llzj/9/9e/6maj0jhsl9v4ndxp0f513bih4hv7816.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">珀列维特</font></div>\n</div></div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left; width:240px;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"skill_icon_box\">\n<div