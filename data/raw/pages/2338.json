, 245); box-shadow: rgb(213, 196, 162) 0px 18px 0px -14px; box-sizing: border-box; visibility: visible;\">\n<div style=\"text-align: center; justify-content: center; margin: -22px 0% 10px; transform: translate3d(1px, 0px, 0px); display: flex; flex-flow: row nowrap; box-sizing: border-box; visibility: visible;\">\n<div style=\"display: inline-block; width: auto; vertical-align: middle; flex: 100 100 0%; height: auto; padding-right: 10px; padding-left: 10px; align-self: center; box-sizing: border-box; visibility: visible;\">\n<div style=\"justify-content: center; margin-right: 0%; margin-left: 0%; transform: translate3d(1px, 0px, 0px); display: flex; flex-flow: row nowrap; box-sizing: border-box; visibility: visible;\">\n<div style=\"display: inline-block; width: auto; vertical-align: top; min-width: 10%; max-width: 100%; flex: 0 0 auto; height: auto; background-color: rgb(243, 230, 204); border-style: solid; border-width: 1px; border-color: rgb(213, 196, 162); padding-right: 6px; padding-left: 6px; align-self: flex-start; box-sizing: border-box; visibility: visible;\">\n<div style=\"display: flex; flex-flow: row nowrap; margin: -1px 0%; justify-content: center; box-sizing: border-box; visibility: visible;\">\n<div style=\"display: inline-block; width: auto; vertical-align: middle; flex: 100 100 0%; align-self: center; height: auto; padding-right: 5px; padding-left: 5px; border-top: 2px solid rgb(243, 230, 204); border-top-left-radius: 0px; border-bottom: 2px solid rgb(243, 230, 204); border-bottom-right-radius: 0px; box-sizing: border-box; visibility: visible;\">\n<div style=\"margin-right: 0%; margin-left: 0%; box-sizing: border-box; visibility: visible;\">\n<div style=\"color: rgb(124, 110, 81); letter-spacing: 4px; box-sizing: border-box; visibility: visible;\">法卡尔</div>\n</div></div></div></div></div></div></div>\n<div style=\"margin-right: 0%; margin-left: 0%; box-sizing: border-box; visibility: visible;\">\n<div style=\"font-size: 14px; color: rgb(62, 62, 62); text-align: center; box-sizing: border-box; visibility: visible;\"><p style=\"text-align: left; text-indent: 2em; box-sizing: border-box; visibility: visible;\"><span style=\"color: rgb(124, 110, 81); box-sizing: border-box; visibility: visible;\">铃兰之剑佣兵团的初期成员，百步穿杨的弓箭手，也是团长最初的伙伴之一。</span></p><p style=\"box-sizing: border-box; visibility: visible;\"><br style=\"box-sizing: border-box; visibility: visible;\" data-filtered=\"filtered\" /></p><p style=\"text-align: left; text-indent: 2em; box-sizing: border-box; visibility: visible;\"><span style=\"color: rgb(124, 110, 81); box-sizing: border-box; visibility: visible;\">法卡尔性格阴郁略带别扭，对外人的警惕性很高。他年幼时曾亲眼目睹家园被战乱所毁，那份心底的阴影直到现在也没能彻底消除。也正是因此，法卡尔特别珍视现在拥有的一切。&#160;</span></p><p style=\"box-sizing: border-box; visibility: visible;\"><br style=\"box-sizing: border-box; visibility: visible;\" data-filtered=\"filtered\" /></p><p style=\"text-align: left; text-indent: 2em; box-sizing: border-box; visibility: visible;\"><span style=\"color: rgb(124, 110, 81); box-sizing: border-box; visibility: visible;\">为了保护好家人和家园，法卡尔会不惜一切。</span></p>\n</div></div></div>\n</div>\n<p><br />\n<img alt=\"官方消息106.jpg\" src=\"https://patchwiki.biligame.com/images/llzj/2/27/cncv010wa3utdd0o1zx4vpr8i6qrv2t.jpg\" decoding=\"async\" loading=\"lazy\" width=\"1080\" height=\"1920\" data-file-width=\"1080\" data-file-height=\"1920\" />\n</p>\n<center><small>*图片内容仅供参考，实际效果以游戏内为准</small></center>\n<p><br />\n<img alt=\"官方消息104.gif\" src=\"https://patchwiki.biligame.com/images/llzj/4/4e/mqwclur2a71tay6w1t7e7sz1zexygzs.gif\" decoding=\"async\" loading=\"lazy\" width=\"1078\" height=\"490\" data-file-width=\"1078\" data-file-height=\"490\" />\n<br /><br />\n</p>\n</div>\n<div class=\"col-sm-3\"></div>\n</div>\n<!-- \nNewPP limit report\nCached time: 20261021172425\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.032 seconds\nReal time usage: 0.057 seconds\nPreprocessor visited node count