2%E8%B5%B0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/6/67/9b4r1m2y4zomwcsggf22ta6ywwcqm79.png/120px-%E6%8A%80%E8%83%BD_%E6%85%A2%E8%B5%B0.png 1.5x, https://patchwiki.biligame.com/images/llzj/6/67/9b4r1m2y4zomwcsggf22ta6ywwcqm79.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />慢走\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>普攻\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>/\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>远程、对地面\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>2-5\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓8-↑6\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓2-↑2\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（普攻）攻击指定目标地形格，造成<font color=\"#ed7950\">70%</font>物攻值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"穿透伤害\" class=\"bili-tt\"><font color=\"orange\">穿透伤害</font></span></span>]，击退<font color=\"#ed7950\">1</font>格，并使地形格变为[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰冻\" class=\"bili-tt\"><font color=\"orange\">冰冻</font></span></span>]；若目标为[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"冰寒地刺\" class=\"bili-tt\"><font color=\"#54b4db\">冰寒地刺</font></span></span>]或[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"爆裂地刺\" class=\"bili-tt\"><font color=\"#54b4db\">爆裂地刺</font></span></span>]，使其立即触发。攻击方式为[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"曲射\" class=\"bili-tt\"><font color=\"orange\">曲射</font></span></span>]。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 2-5 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/0/0e/q94qudm5uvwan42fw7kmhsjx82fxwvh.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_2-5_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/0/0e/q94qudm5uvwan42fw7kmhsjx82fxwvh.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E8%8A%AC%E6%81%A9\" title=\"角色图鉴库/芬恩\"><img alt=\"头像 芬恩.png\" src=\"https://patchwiki.biligame.com/images/llzj/1/1f/b01pwe1sho6hlyp6uhu9i7hkr0kz3jo.png\" decoding=\"async\" loading=\"lazy\" width=\"70\" height=\"70\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:70px;\"><font color=\"#fff\">芬恩</font></div>\n</div>\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justi