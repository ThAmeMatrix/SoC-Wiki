A%E6%80%A7_%E7%A5%9E%E8%B0%95.png 1.5x, https://patchwiki.biligame.com/images/llzj/4/40/hlfzwd63pmc5yzo2kn3twfkvfmx1lxm.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />神谕\n</th>\n<td class=\"wiki-bot text-left\" style=\"width:60%;\">&#160;<img alt=\"个性一星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/56px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/84px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/112px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>自身范围<font color=\"red\">4</font>格内友军释放[<span style=\"display:inline;white-space:nowrap;\">非瞬发</span>]技能后，自身获得1层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"启示\" class=\"bili-tt\"><font color=\"blue\">启示</font></span></span>]，每回合最多触发<font color=\"red\">5</font>次。行动开始时，拥有<font color=\"red\">9</font>层及以上[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"启示\" class=\"bili-tt\"><font color=\"blue\">启示</font></span></span>]，则消耗<font color=\"red\">9</font>层并获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"光谕\" class=\"bili-tt\"><font color=\"blue\">光谕</font></span></span>]。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:20%;\" rowspan=\"5\"><b>该个性属于</b><br /><br /><div class=\"hero_head\" style=\"width:90px;height:90px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%8D%A1%E4%B8%BD%E4%B8%9D\" title=\"角色图鉴库/卡丽丝\"><img alt=\"头像 卡丽丝.png\" src=\"https://patchwiki.biligame.com/images/llzj/a/a1/o3thza8xcn8lqib2d5vwxogsh8udfaq.png\" decoding=\"async\" lo