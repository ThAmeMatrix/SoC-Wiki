%BB%E7%97%B9%E8%8D%AF%E6%B6%82%E6%8A%B9.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/4/48/7kzjj67srrxwz03thzvsl26wuh0u4r3.png/120px-%E6%8A%80%E8%83%BD_%E9%BA%BB%E7%97%B9%E8%8D%AF%E6%B6%82%E6%8A%B9.png 1.5x, https://patchwiki.biligame.com/images/llzj/4/48/7kzjj67srrxwz03thzvsl26wuh0u4r3.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />麻痹药涂抹\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:10%;\"><center><b>&#160;技能类别<br /></b>[职业技能]</center>\n</td>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\">&#160;\n<p>（被动）攻击后，对目标施加<font color=\"#ed7950\">1</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"感染\" class=\"bili-tt\"><font color=\"orange\">感染</font></span></span>]。主动使用[<span style=\"display:inline;white-space:nowrap;\">职业技能</span>]攻击携带<font color=\"#ed7950\">5</font>层以上[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"感染\" class=\"bili-tt\"><font color=\"orange\">感染</font></span></span>]的目标时，攻击后，施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"睡眠\" class=\"bili-tt\"><font color=\"orange\">睡眠</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合。\n</p>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div>\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%B1%B1%E5%9C%B0%E5%B0%84%E6%89%8B%E2%80%9C%E9%94%90%E7%9C%BC%E2%80%9D\" title=\"角色图鉴库/山地射手“锐眼”\"><img alt=\"头像 山地射手“锐眼”.png\" src=\"https://patchwiki.biligame.com/images/llzj/a/a8/qr2bweua2cpf6wkvchflw4ezi7oamgn.png\" decoding=\"async\" loading=\"lazy\" width=\