%A9%E7%94%9F%E4%B8%8D%E8%A8%80%E5%BC%83.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/hedv3sq6c9rp1j43zuszdhwefli89pn.png/120px-%E6%8A%80%E8%83%BD_%E5%A4%A9%E7%94%9F%E4%B8%8D%E8%A8%80%E5%BC%83.png 1.5x, https://patchwiki.biligame.com/images/llzj/5/5d/hedv3sq6c9rp1j43zuszdhwefli89pn.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />天生不言弃\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:10%;\"><center><b>&#160;技能类别<br /></b>[反应]</center>\n</td>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\">&#160;\n<p>（反应）受到近战伤害降低<font color=\"#ed7950\">15%</font>。拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"强力不屈\" class=\"bili-tt\"><font color=\"orange\">强力不屈</font></span></span>]，触发时回复所有能量，移除[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"消停\" class=\"bili-tt\"><font color=\"#54b4db\">消停</font></span></span>]，并获得8层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"炸毛\" class=\"bili-tt\"><font color=\"#54b4db\">炸毛</font></span></span>]；再获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"▲速度4\" class=\"bili-tt\"><font color=\"orange\">▲速度4</font></span></span>]，持续<font color=\"#ed7950\">1</font>回合。\n</p>\n</td></tr></tbody></table>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div>\n<div class=\"hero_head\" style=\"width:70px;height:70px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E9%BB%8E%E5%90%84\" title=\"角色图鉴库/黎各\"><img alt=\"头像 黎各.png\" src=\"https://patchwiki.biligame.com/images/llzj/5/50/g7oyfmhkv95nz1i4nhnv75z7rgcz678.png\" decoding=\"async\" loading=\"