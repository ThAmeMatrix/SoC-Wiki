lkzph6gtvh7qy42eh6jh8fdxxj7iwo.png/120px-%E5%A4%A9%E8%B5%8B_%E5%A4%84%E5%86%B3%E8%80%85.png 1.5x, https://patchwiki.biligame.com/images/llzj/0/05/olkzph6gtvh7qy42eh6jh8fdxxj7iwo.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />处决者\n</th>\n<td class=\"wiki-bot text-left\" style=\"width:60%;\">&#160;<img alt=\"天赋一星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/1/10/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/56px-%E5%A4%A9%E8%B5%8B%E4%B8%80%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/1/10/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/84px-%E5%A4%A9%E8%B5%8B%E4%B8%80%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/1/10/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/112px-%E5%A4%A9%E8%B5%8B%E4%B8%80%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>行动开始时，获得1层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"旋转加速\" class=\"bili-tt\"><font color=\"blue\">旋转加速</font></span></span>]，最多叠加<font color=\"red\">6</font>层。拥有<font color=\"red\">3</font>层时，暴击率提高<font color=\"red\">15%</font>。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:20%;\" rowspan=\"5\"><b>该个性属于</b><br /><br /><div class=\"hero_head\" style=\"width:90px;height:90px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E5%98%89%E8%A5%BF%E5%A8%85\" title=\"角色图鉴库/嘉西娅\"><img alt=\"头像 嘉西娅.png\" src=\"https://patchwiki.biligame.com/images/llzj/b/b6/nv5mm0040teilfvgwt56yd4s6chl5dg.png\" decoding=\"async\" loading=\"lazy\" width=\"90\" height=\"90\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:90px;\"><font color=\"#fff\">嘉西娅</font></div>\n</div>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"天赋二星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/56px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/84px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/2/23/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/112px-%E5%A4%A9%E8%B5%8B%E4%BA%8C%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>行动开始时，获得1层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"旋转加速\" class=\"bili-tt\"><font color=\"blue\">旋转加速</font></span></span>]，最多叠加<font color=\"red\">6</font>层。拥有<font color=\"red\">3</font>层时，暴击率提高<font color=\"red\">30%</font>。战斗开始时，获得<font color=\"red\">1</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"旋转加速\" class=\"bili-tt\"><font color=\"blue\">旋转加速</font></span></span>]。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"天赋三星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/56px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/84px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/5/5d/czx3heixk04558ia8wj7hpokhzl5cbx.png/112px-%E5%A4%A9%E8%B5%8B%E4%B8%89%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>行动开始时，获得1层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"旋转加速\" class=\"bili-tt\"><font color=\"blue\">旋转加速</font></span></span>]，最多叠加<font color=\"red\">9</font>层。拥有<font color=\"red\">3</font>层时，暴击率提高<font color=\"red\">30%</font>。拥有<font color=\"red\">6</font>层时，暴击伤害提高<font color=\"red\">15%</font>。战斗开始时，获得<font color=\"red\">1</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"旋转加速\" class=\"bili-tt\"><font color=\"blue\">旋转加速</font></span></span>]。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"天赋四星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/56px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/84px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/3/31/eer5d47lht2ycljkd8fe3yu05q10ccr.png/112px-%E5%A4%A9%E8%B5%8B%E5%9B%9B%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>行动开始时，获得1层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"旋转加速\" class=\"bili-tt\"><font color=\"blue\">旋转加速</font></span></span>]，最多叠加<font color=\"red\">9</font>层。拥有<font color=\"red\">3</font>层时，暴击率提高<font color=\"red\">30%</font>。拥有<font color=\"red\">6</font>层时，暴击伤害提高<font color=\"red\">30%</font>。战斗开始时，获得<font color=\"red\">2</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"旋转加速\" class=\"bili-tt\"><font color=\"blue\">旋转加速</font></span></span>]。\n</p>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"天赋五星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/b/bf/l6fgusj2lxp7caktkwbmf1ioo2m7utz.png/56px-%E5%A4%A9%E8%B5%8B%E4%BA%94%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/b/bf/l6fgusj2lxp7caktkwbmf1ioo2m7utz.png/84px-%E5%A4%A9%E8%B5%8B%E4%BA%94%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/b/bf/l6fgusj2lxp7caktkwbmf1ioo2m7utz.png/112px-%E5%A4%A9%E8%B5%8B%E4%BA%94%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>行动开始时，获得1层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"旋转加速\" class=\"bili-tt\"><font color=\"blue\">旋转加速</font></span></span>]，最多叠加<font color=\"red\">9</font>层。拥有<font color=\"red\">3</font>层时，暴击率提高<font color=\"red\">30%</font>。拥有<font color=\"red\">6</font>层时，暴击伤害提高<font color=\"red\">30%</font>。拥有<font color=\"red\">9</font>层时，无视目标[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"格挡\" class=\"bili-tt\"><font color=\"orange\">格挡</font></span></span>]，无视<font color=\"red\">40%</font>防御。战斗开始时，获得<font color=\"red\">2</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"旋转加速\" class=\"bili-tt\"><font color=\"blue\">旋转加速</font></span></span>]。\n</p>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20261022163705\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.212 seconds\nReal time usage: 0.326 seconds\nPreprocessor visited node count: 5676/1000000\nPost‐expand include size: 44299/2097152 bytes\nTemplate argument size: 9905/2097152 bytes\nHighest expansion depth: 13/40\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\nExtLoops count: 0\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  294.939      1 模板:天赋\n100.00%  294.939      1 -total\n 30.65%   90.408      5 模板:中括号介绍化\n 27.36%   80.683     10 模板:中括号介绍\n  3.76%   11.096      1 模板:面包屑\n  1.83%    5.412      1 模板:列表/头像\n-->\n\n<!-- Saved in parser cache with key gamecenter_wiki_llzj-pre_:pcache:idhash:2445-0!dateformat=default and timestamp 20261022163705 and revision id 5337. Serialized with PHP.\n -->\n</div>","categories":[{"sortkey":"","category":"天赋","missing":true}],"images":["天赋_处决者.png","天赋一星.png","头像_嘉西娅.png","天赋二星.png","天赋三