zj/thumb/5/51/pibuw38rvgyjbzxswa6hflvwe97rdc4.png/80px-%E6%8A%80%E8%83%BD_%E5%BE%81%E6%9C%8D%E5%AE%A3%E8%A8%80.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/5/51/pibuw38rvgyjbzxswa6hflvwe97rdc4.png/120px-%E6%8A%80%E8%83%BD_%E5%BE%81%E6%9C%8D%E5%AE%A3%E8%A8%80.png 1.5x, https://patchwiki.biligame.com/images/llzj/5/51/pibuw38rvgyjbzxswa6hflvwe97rdc4.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />征服宣言\n</th>\n<td class=\"text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;消耗：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" style=\"width:30%;\" colspan=\"2\"><b>&#160;技能类别：</b>职业技能\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;冷却：</b>4\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;攻击方式：</b>范围攻击、对单位\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程：</b>1-5\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;射程高低差：</b>↓8-↑8\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围：</b>0\n</td>\n<td class=\"wiki-bot text-left text-nowrap\" colspan=\"2\"><b>&#160;范围高低差：</b>↓0-↑0\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\" style=\"width:70%;\" colspan=\"3\">\n<p>（物理伤害）[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"瞬发\" class=\"bili-tt\"><font color=\"orange\">瞬发</font></span></span>]，攻击指定目标，造成<font color=\"#ed7950\">30%</font>范围伤害。攻击后，对目标施加<font color=\"#ed7950\">6</font>层[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"威压\" class=\"bili-tt\"><font color=\"#54b4db\">威压</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合；自身获得[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"蔑视\" class=\"bili-tt\"><font color=\"#54b4db\">蔑视</font></span></span>]，持续<font color=\"#ed7950\">4</font>回合，及获得<font color=\"#ed7950\">30%</font>生命值的[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"物理护盾\" class=\"bili-tt\"><font color=\"orange\">物理护盾</font></span></span>]\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:10%;\"><img alt=\"技能范围 1-5 0.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/9/95/at4dr45s2ma4cti9dv4gkekpa78egvl.png/80px-%E6%8A%80%E8%83%BD%E8%8C%83%E5%9B%B4_1-5_0.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/9/95/at4dr45s2ma4cti9dv4gkekpa78egvl.png 1.5x\" data-file-width=\"90\" data-file-height=\"90\" />\n</td></tr></tbody></table>\n</div>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th colspan=\"2\">可习得该技能的角色\n</th></tr>\n<tr>\n<th style=\"width:10%;\"><b>门外</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr>\n<tr>\n<th style=\"width:10%;\"><b>门内</b>\n</th>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<table class=\"wikitable\" style=\"width:100%;text-align:center\">\n<tbody><tr>\n<th style=\"width:10%;\">关联内容\n</th>\n<td style=\"text-align:left;\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td>\n<td style=\"text-align:left\"><div style=\"display: flex;justify-content: space-evenly;width: fit-content;flex-wrap: wrap;\">\n</div>\n</td></tr></tbody></table>\n<p><br />\n</p>\n<!-- \nNewPP limit report\nCached time: 20261022104753\nCache expiry: 86400\nReduced expiry: false\nComplications: []\n[SMW] In‐text annotation parser time: 0 seconds\nCPU time usage: 0.408 seconds\nReal time usage: 0.552 seconds\nPrep