%8A%A8%E9%98%9F%E4%BD%9C%E6%88%98%E5%8F%82%E8%B0%8B.png\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"jndtb\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/f/f1/rf5rt55abl3nyxfpb5jbwv4un452uml.png/120px-%E4%B8%AA%E6%80%A7_%E6%9C%BA%E5%8A%A8%E9%98%9F%E4%BD%9C%E6%88%98%E5%8F%82%E8%B0%8B.png 1.5x, https://patchwiki.biligame.com/images/llzj/f/f1/rf5rt55abl3nyxfpb5jbwv4un452uml.png 2x\" data-file-width=\"128\" data-file-height=\"128\" /><br />机动队作战参谋\n</th>\n<td class=\"wiki-bot text-left\" style=\"width:60%;\">&#160;<img alt=\"个性一星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/56px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/84px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/f/ff/it8jh8njwjg4jrxn4b2f0iwnlxlm1a7.png/112px-%E4%B8%AA%E6%80%A7%E4%B8%80%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>自身范围<font color=\"#ed7950\">5</font>格内所有己方，攻击拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"机动队标记\" class=\"bili-tt\"><font color=\"blue\">机动队标记</font></span></span>]的目标时，攻击增加<font color=\"#ed7950\">5%</font>。<br />对友军主动释放支援技能，或被动触发治疗效果后，对其施加<font color=\"#ed7950\">1</font>个随机[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"1级属性增益\" class=\"bili-tt\"><font color=\"orange\">1级属性增益</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合；在行动开始时，对自身<font color=\"#ed7950\">6</font>格范围内所有敌人施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"机动队标记\" class=\"bili-tt\"><font color=\"blue\">机动队标记</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合。\n</p>\n</td>\n<td class=\"text-nowrap\" style=\"width:20%;\" rowspan=\"5\"><b>该个性属于</b><br /><br /><div class=\"hero_head\" style=\"width:90px;height:90px;\">\n<div class=\"hero_head_img\"><a href=\"/llzj/%E8%A7%92%E8%89%B2%E5%9B%BE%E9%89%B4%E5%BA%93/%E7%B4%A2%E8%8F%B2%E4%BA%9A%E2%80%A2%E5%A4%8F%E6%97%A5%E7%BA%A6%E5%AE%9A\" title=\"角色图鉴库/索菲亚•夏日约定\"><img alt=\"头像 索菲亚•夏日约定.png\" src=\"https://patchwiki.biligame.com/images/llzj/d/d0/nxkr945r9xdfhlt9mt9s3px7qqg39ek.png\" decoding=\"async\" loading=\"lazy\" width=\"90\" height=\"90\" class=\"img-kk\" data-file-width=\"64\" data-file-height=\"64\" /></a></div>\n<div class=\"hero_head_name\" style=\"width:90px;\"><font color=\"#fff\">索菲亚•夏日约定</font></div>\n</div>\n</td></tr>\n<tr>\n<td class=\"wiki-bot text-left\">&#160;<img alt=\"个性二星.png\" src=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e0/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/56px-%E4%B8%AA%E6%80%A7%E4%BA%8C%E6%98%9F.png\" decoding=\"async\" loading=\"lazy\" width=\"56\" height=\"14\" srcset=\"https://patchwiki.biligame.com/images/llzj/thumb/e/e0/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/84px-%E4%B8%AA%E6%80%A7%E4%BA%8C%E6%98%9F.png 1.5x, https://patchwiki.biligame.com/images/llzj/thumb/e/e0/s8dzgwxdvuvhjug8aqjcnr6vmgsi5ao.png/112px-%E4%B8%AA%E6%80%A7%E4%BA%8C%E6%98%9F.png 2x\" data-file-width=\"224\" data-file-height=\"56\" /><br />&#160;\n<p>自身范围<font color=\"#ed7950\">5</font>格内所有己方，攻击拥有[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"机动队标记\" class=\"bili-tt\"><font color=\"blue\">机动队标记</font></span></span>]的目标时，攻击增加<font color=\"#ed7950\">10%</font>。<br />对友军主动释放支援技能，或被动触发治疗效果后，对其施加<font color=\"#ed7950\">1</font>个随机[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"1级属性增益\" class=\"bili-tt\"><font color=\"orange\">1级属性增益</font></span></span>]，持续<font color=\"#ed7950\">2</font>回合；在行动开始时，对自身<font color=\"#ed7950\">6</font>格范围内所有敌人施加[<span style=\"display:inline;white-space:nowrap;\"><span data-type=\"@悬浮框/中括号介绍\" data-name=\"机动队标记\"